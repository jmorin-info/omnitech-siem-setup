    sigfr = [s for s in _signaux_fr(ctx.get("signaux")) if s not in ("règle critique", "à qualifier")]
    if sigfr: grav += f"<br><span style='color:#6b7280;font-size:12px'>{esc(', '.join(sigfr))}</span>"
    regle_txt = re.sub(r"^OMNI(?:\s+v\d+)?\s*-\s*", "", ctx.get("titre", ""))
