def _llm_cloud(e, key, model, prompt):
    """Appel du juge LLM distant (logique d'origine ; URL, en-tête de version et modèle lus dans le .env)."""
    global _LLM_DOWN_UNTIL
    body = json.dumps({"model":model,"max_tokens":500,
        "messages":[{"role":"user","content":prompt}]}).encode()
    try:
        _h = {"x-api-key": key, "content-type": "application/json"}
        for _p in (e.get("OMNI_LLM_ENTETE") or "").split(";"):   # "Nom: valeur;Nom2: valeur2"
            if ":" in _p: _h[_p.split(":", 1)[0].strip()] = _p.split(":", 1)[1].strip()
        req = urllib.request.Request(e.get("OMNI_LLM_URL") or "", data=body,
            headers=_h)
        r = json.load(urllib.request.urlopen(req, timeout=20))
        txt = "".join(b.get("text","") for b in r.get("content",[]))
        j = json.loads(re.search(r"\{.*\}", txt, re.S).group(0))
        verdict = bool(j.get("mail"))
        # L'EXPLICATION est conservee telle quelle : c'est elle qui est affichee a
        # l'analyste dans le mail. Auparavant seule une "raison" de 60 caracteres
        # etait gardee, puis remplacee a l'affichage par une phrase generique :
        # le lecteur ne savait jamais POURQUOI l'alerte lui etait adressee.
        expl = str(j.get("explication") or j.get("raison") or "").strip()
        if len(expl) > 400:                      # couper a une FIN DE PHRASE
            cut = expl.rfind(". ", 0, 400)
            expl = (expl[:cut + 1] if cut > 120 else expl[:397].rsplit(" ", 1)[0] + "...")
        print(f"[juge] mail={verdict} | {str(j.get('raison',''))[:60]} | {expl[:120]}",
              flush=True)
        return verdict, "llm:" + (expl or str(j.get("raison",""))[:60])
    except Exception as ex:
        _LLM_DOWN_UNTIL = time.time() + int(e.get("LLM_PAUSE_SECONDS", "3600") or 3600)
        _det = ""
        try:
            if hasattr(ex, "read"):
                _det = json.loads(ex.read().decode("utf-8", "replace")).get("error", {}).get("message", "")[:120]
        except Exception: pass
        print(f"[juge] echec {type(ex).__name__} {_det} -> pause {int(_LLM_DOWN_UNTIL - time.time())} s", flush=True)
        return None, f"llm_erreur:{type(ex).__name__}"

