# Ancre sur une SIGNATURE FortiGate : sinon tout log mono-ligne d'un AUTRE equipement
# avec >=4 tokens cle=valeur (vSphere, BunkerWeb, Linux pam/auditd) etait reformate a
# tort comme du Forti (constat audit multi-agents 06/07/2026 : vsphere 43/500, bunkerweb 13/500).
_FORTI_SIG = re.compile(r'\b(?:logver|devname|emsserial|device_id|logid|log_id)=')

def _looks_forti_kv(raw):
    raw = raw.strip()
    return ("\n" not in raw) and len(_KV_RE.findall(raw)) >= 4 and bool(_FORTI_SIG.search(raw))

def _parse_forti_kv(raw):
    """key=value (+ valeurs quotees) -> dict ordonne {cle: (cle, valeur)}, bruit exclu."""
    d, order = {}, []
    for m in _KV_RE.finditer(raw):
        k, v = m.group(1), m.group(2)
        if len(v) >= 2 and v[0] == '"' and v[-1] == '"':
            v = v[1:-1]
        kl = k.lower()
        if kl in _FORTI_NOISE or kl in d:
            continue
        if v in ("", "-", "0.0.0.0", "N/A", "n/a"):
            continue
        d[kl] = (k, v); order.append(kl)
    prio = [k for k in _FORTI_ORDER if k in d]
    rest = [k for k in order if k not in prio]
    return d, prio + rest

# --- Logs a payload JSON (ESET ERAServer, certains connecteurs) : "prefixe syslog {json}".
# _format_log les rendait en blob tronque a 240c (action_taken perdue). On extrait l'objet
# JSON et on affiche ses champs lisiblement, champs utiles d'abord. (audit 06/07/2026)
_JSON_ORDER = ["event_type", "severity", "threat_name", "threat_type", "threat_handled",
    "action_taken", "action", "object_uri", "object_name", "hash", "process_name",
    "processname", "username", "user", "account", "hostname", "computer_name", "ipv4",
    "ipv6", "source_uuid", "rule_name", "category", "detection", "scanner_id"]
def _extract_json(raw):
    m = re.search(r'\{.*\}', raw, re.S)
    if not m:
        return None
    try:
        obj = json.loads(m.group(0))
        return obj if isinstance(obj, dict) and obj else None
    except Exception:
        return None
def _json_keys(obj):
    return [k for k in _JSON_ORDER if k in obj] + [k for k in obj if k not in _JSON_ORDER]

def _format_log(message, max_lines=24):
    """Message brut -> lignes HTML lisibles (cle grise + valeur), bruit masque."""
    raw = str(message or "").replace("\xa0", " ").replace("\r", "")
    if _looks_forti_kv(raw):
        d, keys = _parse_forti_kv(raw)
        out = []
        for kl in keys[:max_lines]:
            k, v = d[kl]
            out.append('<div><span style="display:inline-block;min-width:170px;'
                       f'color:#868e96;vertical-align:top">{_esc(k)}</span>'
                       f'<span style="color:#212529">{_esc(v[:240])}</span></div>')
        if len(keys) > max_lines:
            out.append('<div style="color:#adb5bd">[…]</div>')
        return "".join(out)
    _j = _extract_json(raw)
    if _j is not None:
        out = []
        for k in _json_keys(_j)[:max_lines]:
            v = _j[k]
            if v in (None, "", "-"):
                continue
            out.append('<div><span style="display:inline-block;min-width:170px;'
                       f'color:#868e96;vertical-align:top">{_esc(k)}</span>'
                       f'<span style="color:#212529">{_esc(str(v)[:240])}</span></div>')
        if out:
            return "".join(out)
    out, n = [], 0
    for line in raw.split("\n"):
        line = line.replace("\t", " ").strip()
        if not line:
            continue
        if ":" in line:
            k, _, v = line.partition(":")
            k, v = k.strip(), v.strip()
            if _noaccent(k).lower() in _LOG_NOISE_KEYS:
                continue
            if v == "":                                   # sous-titre (ex "Sujet :")
                out.append(f'<div style="color:#5f3dc4;font-weight:700;margin-top:6px">{_esc(k)}</div>')
            elif v.lower() in _LOG_NULL_VALS:             # valeur nulle -> masquee
                continue
            else:
                out.append('<div><span style="display:inline-block;min-width:170px;'
                           f'color:#868e96;vertical-align:top">{_esc(k)}</span>'
                           f'<span style="color:#212529">{_esc(v[:240])}</span></div>')
        else:
            out.append(f'<div style="color:#343a40;font-weight:600">{_esc(line[:240])}</div>')
        n += 1
        if n >= max_lines:
            out.append('<div style="color:#adb5bd">[…]</div>')
            break
    return "".join(out)

def _format_log_text(message, max_lines=24):
    """Version TEXTE de _format_log (fallback mail plain)."""
    raw = str(message or "").replace("\xa0", " ").replace("\r", "")
    if _looks_forti_kv(raw):
        d, keys = _parse_forti_kv(raw)
        out = [f"       {d[kl][0]}: {d[kl][1][:240]}" for kl in keys[:max_lines]]
        if len(keys) > max_lines:
            out.append("       [...]")
        return "\n".join(out)
    _j = _extract_json(raw)
    if _j is not None:
        out = [f"       {k}: {str(_j[k])[:240]}" for k in _json_keys(_j)[:max_lines]
               if _j[k] not in (None, "", "-")]
        if out:
            return "\n".join(out)
    out, n = [], 0
    for line in raw.split("\n"):
        line = line.replace("\t", " ").strip()
        if not line:
            continue
        if ":" in line:
            k, _, v = line.partition(":")
            k, v = k.strip(), v.strip()
            if _noaccent(k).lower() in _LOG_NOISE_KEYS or v.lower() in _LOG_NULL_VALS:
                continue
            out.append(f"       {k}: {v[:240]}" if v else f"      {k}")
        else:
            out.append(f"      {line[:240]}")
        n += 1
        if n >= max_lines:
            out.append("       [...]"); break
    return "\n".join(out)

def backlog_rows(payload, limit=5):
    """Evenements declencheurs (contexte forensique) : ts + source + extrait + log brut."""
    out = []
    for it in (payload.get("backlog") or [])[:limit]:
        m = it.get("message") if isinstance(it, dict) and isinstance(it.get("message"), dict) else (it if isinstance(it, dict) else {})
        out.append({"ts": str(m.get("timestamp", ""))[:19].replace("T", " "),
                    "src": str(m.get("source", "")),
                    "msg": _msg_excerpt(m),
                    "raw": str(m.get("message", ""))})
    return out

