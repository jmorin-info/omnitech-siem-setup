_SIG_FR = {"critique": "règle critique", "zone_grise": "à qualifier", "bruit": "signal faible",
           "prio_haute": "priorité haute", "actif_critique": "actif critique", "threat_intel": "IP réputée malveillante",
           "hors_heures": "hors heures ouvrées"}
def _signaux_fr(sig):
    out = []
    for s in sig or []:
        m = re.match(r"killchain\(x(\d+)\)", s); m2 = re.match(r"progression_attaque\((\d+)_tactiques\)", s)
        out.append(f"{m.group(1)} détections corrélées" if m else
                   f"progression sur {m2.group(1)} tactiques ATT&CK" if m2 else _SIG_FR.get(s, s))
    return out

def _ou_items(ctx, site):
    """Liste ordonnée (libellé, valeur, complément) décrivant OÙ, sans doublon."""
    items, vus = [], set()
    def add(lab, val, extra=""):
        v = str(val or "").strip()
        if not v or v in ("-", "(Empty Value)") or v.lower() in vus: return
        vus.add(v.lower()); items.append((lab, v, extra))
    lab, val = _entity_label(ctx.get("entite"))
    if lab == "Source": lab = "Équipement"
    if lab == "Concerne" and ctx.get("seal_site"): val = ""          # clé SEAL brute : remplacée par site/porte/badge
    add("Machine", ctx.get("host"))
    add("Compte", ctx.get("user"))
    ip = ctx.get("src_ip") or ctx.get("dest_ip")
    if ip:
        ex = (f"{_pays(ctx['country'])}" if ctx.get("country") else "") + (" — réputée malveillante" if ctx.get("ti") else "")
        add("Adresse IP", ip, ex.strip(" —"))
    if val: add(lab, val, site if site not in ("-", "", None) else "")
    if ctx.get("seal_site"):
        add("Site physique", ctx["seal_site"])
        add("Zone", ctx.get("seal_zone")); add("Porte / capteur", ctx.get("seal_porte")); add("Badge", ctx.get("seal_badge"))
    if ctx.get("net"): add("Réseau", ctx["net"])
    if ctx.get("dest_port"): add("Port ciblé", ctx["dest_port"])
    if ctx.get("dns_name"): add("Enregistrement DNS", ctx["dns_name"], ctx.get("dns_zone", ""))
    return items

def _quand_evt(ctx):
    q = M3.quand(ctx.get("ts")) if ctx.get("ts") else M3.quand()
    tss = sorted(b["ts"] for b in (ctx.get("backlog") or []) if b.get("ts"))
    prem = M3.quand(tss[0]) if tss else ""
    return q, (prem if prem and prem != q else "")

# Détections sans playbook (alert_tag absent) qui partent en mail : consigne dédiée plutôt que générique.
_QUE_FAIRE_TITRES = [
    (r"fortigate : usage du compte local admin", [
        ("Vérifier", "Qui a utilisé le compte local « admin » du FortiGate (IP source, poste, heure) et pourquoi : ce compte est réservé au secours, l'administration courante passe par SAML / ADM_Security."),
        ("Si ce n'est pas prévu", "Changer le mot de passe du compte admin local, relire les changements de configuration (journal système, différences FortiManager), vérifier les administrateurs et sessions ouvertes, prévenir le RSSI.")]),
]
def _que_faire(ctx, g, niveau):
    """Actions recommandées concrètes : playbook de la détection, sinon conduite par défaut selon la gravité."""
    acts = []
    if not g:
        for rx, a in _QUE_FAIRE_TITRES:
            if re.search(rx, ctx.get("titre", ""), re.I): acts = list(a); break
    if g:
        if g.get("a_verifier"):  acts.append(("Vérifier", g["a_verifier"]))
        if g.get("remediation"): acts.append(("Si c'est confirmé", g["remediation"]))
    if ctx.get("threat") and str(ctx.get("av_remediated", "")).lower() in ("false", "0", "non"):
        acts.insert(0, ("En priorité", "La menace n'a pas été neutralisée par l'antivirus : isoler le poste (ESET / NinjaOne) et lancer une analyse complète."))
    if not acts:
        if niveau == "CRITIQUE":
            acts = [("Vérifier", "Confirmer tout de suite l'activité avec le propriétaire de la machine ou du compte (était-ce lui, était-ce prévu ?)."),
                    ("Si c'est suspect", "Isoler la machine (ESET / NinjaOne), désactiver ou réinitialiser le compte, conserver les journaux, prévenir le RSSI.")]
        else:
            acts = [("Vérifier", "Ouvrir les événements dans Graylog et confirmer avec l'utilisateur ou l'équipe concernée qu'il s'agit d'une opération connue."),
                    ("Ensuite", "Si c'est légitime et récurrent, le marquer comme faux positif (signature précise) ; sinon traiter comme un incident.")]
    acts.append(("Qualifier", "Clore ou escalader l'alerte dans la console SOC pour garder la trace de la décision."))
    return acts

def _extrait_v3(bl, ctx):
    """Extrait utile du 1er événement : pour un journal FortiGate (clé=valeur), le message humain (msg) et
    l'action ; sinon l'extrait compact habituel."""
    raw = str(bl[0].get("raw", "")) if bl else str(ctx.get("message") or "")
    try:
        if raw and _looks_forti_kv(raw):
            d, _k = _parse_forti_kv(raw)
            parts = [d[k][1] for k in ("msg",) if k in d] + [f"{d[k][0]}={d[k][1]}" for k in ("action", "status", "user", "srcip", "ui") if k in d]
            if parts: return " | ".join(parts)[:300]
    except Exception:
        pass
    if bl and bl[0].get("msg"): return bl[0]["msg"]
    return re.sub(r"\s+", " ", raw)[:260]

def _court(s, n=420):
    s = re.sub(r"\s+", " ", str(s or "")).strip()
    if len(s) <= n: return s
    cut = s.rfind(". ", 0, n)
    return s[:cut + 1] if cut > n // 2 else s[:n - 1].rsplit(" ", 1)[0] + "…"

def _seal_bloc(ctx):
    """v4b : (html, [lignes texte]) décrivant l'alarme SEAL suivie ; ('', []) hors alarme SEAL."""
    if not ctx.get("seal_alarme_id"): return "", []
    esc = M3.esc
    typ = (ctx.get("seal_type") or ctx.get("seal_action") or "") + (f" ({ctx['seal_reev']})" if ctx.get("seal_reev") else "")
    ouv = M3.quand(ctx["seal_ouverture"]) if ctx.get("seal_ouverture") else (M3.quand(ctx["seal_ouverture_txt"]) if ctx.get("seal_ouverture_txt") else "")
    duree = _duree_txt(ctx.get("seal_age_min")) if ctx.get("seal_age_min") not in (None, "") else ""
    porte = ctx.get("seal_porte") if ctx.get("seal_porte") not in (None, "", "-", "(Empty Value)") else ""
    lignes = [f"Alarme n° {ctx['seal_alarme_id']}" + (f" · {typ}" if typ else ""),
              f"Site {ctx.get('seal_site') or '-'} · porte / capteur : " + (porte or "non transmis(e) par SEAL")
              + (f" · zone {ctx['seal_zone']}" if ctx.get("seal_zone") else "")]
    if ouv or duree: lignes.append("Ouverte le " + (ouv or "?") + (f" · depuis {duree}" if duree else ""))
    if ctx.get("seal_sla_min") not in (None, "") or ctx.get("seal_sla_etat"):
        lignes.append(f"SLA {ctx.get('seal_sla_classe', '')} {ctx.get('seal_sla_min', '?')} min : dépassé · état {ctx.get('seal_sla_etat', '?')}"
                      + (f" · escalade x{ctx['seal_escalade']}" if ctx.get("seal_escalade") not in (None, "") else ""))
    if "seal_rappels" in ctx:
        n = int(ctx.get("seal_rappels") or 0); h = int(ctx.get("seal_rappel_h") or 4)
        lignes.append((f"Rappel n°{n} : {n} mail(s) déjà envoyé(s) pour cette alarme" + (f", le premier le {M3.quand(ctx['seal_premier_mail'])}" if ctx.get("seal_premier_mail") else "")
                       if n else "Premier mail pour cette alarme")
                      + f" ; rappel toutes les {h} h tant qu'elle reste ouverte")
    if ctx.get("seal_brut_absent"):
        lignes.append("Événement SEAL d'origine absent du SIEM : seule la réémission du suivi SLA a été reçue (porte et zone à lire dans la console SEAL)")
    html = "<br>".join(esc(x) if i else f"<b>{esc(x)}</b>" for i, x in enumerate(lignes))
    return html, lignes

