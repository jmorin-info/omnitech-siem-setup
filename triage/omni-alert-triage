    quoi_h = f"<b style='font-size:15px'>{esc(quoi)}</b>" + (f"<div style='color:#4b5563;font-size:13px;margin-top:3px'>{esc(_court(desc_q, 300))}</div>" if desc_q else "")
    ou_h = "<br>".join(f"<span style='color:#6b7280'>{esc(l)}</span> <b>{esc(v)}</b>" + (f" <span style='color:#6b7280'>({esc(x)})</span>" if x else "") for l, v, x in ou) or "<span style='color:#6b7280'>non précisé dans l'alerte (voir les événements)</span>"
    quand_h = f"<b>{esc(q)}</b> <span style='color:#6b7280'>(heure de Paris)</span>" + (f"<br><span style='color:#6b7280'>premier événement : {esc(prem)}</span>" if prem else "")
    _cnt = ctx.get("count")
    if ctx.get("count_reel") and str(_cnt) not in ("0", "0.0"):
        quand_h += f"<br><span style='color:#6b7280'>{esc(_cnt)} occurrence(s) sur la fenêtre d'analyse</span>"
    elif ctx.get("count_reel"):
        quand_h += "<br><span style='color:#6b7280'>aucun événement reçu sur la fenêtre : flux muet</span>"
