    ou_court = next((v for l, v, x in ou if l in ("Machine", "Compte", "Équipement", "Site physique")), "") or (ou[0][1] if ou else "")
    if l_ := re.match(r"^([A-Za-z0-9-]+)\.omnitech\.security$", ou_court or ""): ou_court = l_.group(1)
