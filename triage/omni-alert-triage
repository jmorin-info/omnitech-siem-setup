    try:
        for line in open(ENVFILE):
            m = re.match(r"\s*([A-Z_]+)=(.*)", line)
            if m: e[m.group(1)] = m.group(2).strip().strip("'").strip('"')
    except OSError: pass
    return e

def _valid_patterns(pats):
    # Un motif regex invalide (ex. faute de frappe dans tiers.json) leverait re.error
    # dans classify() HORS du try du handler -> plantage silencieux de TOUT le triage,
    # aucune alerte envoyee. On compile-teste et on ignore les motifs invalides.
    out = []
    for rx in pats:
        try:
            re.compile(rx); out.append(rx)
        except re.error:
            print(f"tiers: motif regex invalide ignore: {rx!r}", file=sys.stderr)
    return out

