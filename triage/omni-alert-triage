# La valeur d'un champ bruit s'arrete au PROCHAIN token 'Mot:' (les messages
# Sysmon sont monolignes) ou a la fin ; sinon on effacerait toute la suite.
_MSG_NOISE = re.compile(
    r"\b(?:RuleName|UtcTime|ProcessGuid|ProcessId|LogonGuid|LogonId|"
    r"TerminalSessionId|SourceProcessGUID|TargetProcessGUID|ParentProcessGuid|"
    r"ParentProcessId|FileVersion|IntegrityLevel|Hashes|Company|Product|"
    r"Description|OriginalFileName|CurrentDirectory|QueryStatus)\s*:\s*"
    r".*?(?=\s+[A-Z][A-Za-z]+:\s|$)")

def _msg_excerpt(m, cap=260):
    """Ligne compacte et informative pour un evenement declencheur."""
    pairs = []
    for label, keys in _EXCERPT_FIELDS:
        for k in keys:
            v = m.get(k)
            if v not in (None, "", "-", "0.0.0.0"):
                v = str(v).strip()
                pairs.append(f"{label}={v[:90]}" + ("…" if len(v) > 90 else ""))
                break
        if len(pairs) >= 5:
            break
    if len(pairs) >= 2:
        s = " | ".join(pairs)
        return s[:cap] + ("…" if len(s) > cap else "")   # plafonne comme le fallback (audit 17/07)
    # fallback : message brut debarrasse du bruit Windows/Sysmon
    raw = str(m.get("message", ""))
    raw = _MSG_NOISE.sub("", raw)
    raw = re.sub(r"\s+", " ", raw).strip(" -:")
    if pairs:
        raw = pairs[0] + " | " + raw
    return raw[:cap] + ("…" if len(raw) > cap else "")

