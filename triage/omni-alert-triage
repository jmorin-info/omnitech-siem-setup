        mt = esc(ctx["mitre_tech"]) + (" · " + esc(ctx["mitre_name"]) if ctx.get("mitre_name") else "")
        tags += M3.puce(mt, "#3730a3", "#eef2ff", "#c7d2fe", mitre_url(ctx["mitre_tech"]) or None)
        if ctx.get("mitre_tac"): tags += M3.puce(esc(ctx["mitre_tac"]))
    if ctx.get("ti"): tags += M3.puce("IP réputée malveillante", "#b91c1c", "#fef2f2", "#fecaca")
    if tags: pq += f"<div style='margin-top:6px'>{tags}</div>"
    if why: pq += f"<div style='color:#4b5563;font-size:13px;margin-top:2px'>{esc(why)}</div>"
    if ctx.get("threat"):
        pq += (f"<div style='margin-top:4px'>Menace : <b>{esc(ctx['threat'])}</b>" + (f" ({esc(ctx['threat_type'])})" if ctx.get("threat_type") else "")
               + (f" · action antivirus : {esc(ctx['av_action'])}" if ctx.get("av_action") else "") + "</div>")
    bl = ctx.get("backlog") or []
