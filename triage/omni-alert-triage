def flag(cc):
    cc = (cc or "").strip().upper()
    if len(cc) != 2 or not cc.isalpha(): return ""
    return "".join(chr(0x1F1E6 + ord(c) - ord('A')) for c in cc)

def mitre_url(tech):
    t = (tech or "").strip().upper()
    if not re.match(r"^T\d{4}(\.\d{3})?$", t): return ""   # ancre fin : rejette T1234">... (injection)
    return "https://attack.mitre.org/techniques/" + (t[:5] + "/" + t[6:] + "/" if "." in t else t + "/")

def rationale(tier, reason, score):
    # Formulation SOBRE, sans jargon interne ni mention "IA" (audit 14/08/2026).
    r = (reason or "").lower()
    if "killchain" in r:   return "Plusieurs détections corrélées sur la même entité."
    if tier == "CRITICAL": return "Signal de sécurité critique — traitement immédiat requis."
    if r.startswith("llm:"): return "Signal qualifié comme pertinent après analyse contextuelle."
    return f"Niveau de risque élevé ({score}/100)."

def quick_sign(secret, action, entity, tag, exp):
    return hmac.new(secret.encode(), f"{action}|{entity}|{tag}|{exp}".encode(), hashlib.sha256).hexdigest()[:32]
def quick_fp_link(e, entity, tag):
    """Lien signé (7j) 'Marquer faux positif' -> /m/api/quick (page de confirmation).
    EXIGE un tag (détection précise) : sans tag, un clic mettrait en sourdine TOUTE
    l'entité -> on ne propose pas le lien (le FP entité-large reste possible via /soc/)."""
    secret = e.get("QUICK_SECRET", "")
    if not secret or not entity or entity == "-" or not tag: return ""
    exp = int(time.time()) + 7*86400
    p = urllib.parse.urlencode({"a": "fp", "e": entity, "tag": tag or "",
                                "exp": exp, "sig": quick_sign(secret, "fp", entity, tag or "", exp)})
    return f"{GL_BASE}/m/api/quick?{p}"

def is_public_ip(ip):
    try:
        a = ipaddress.ip_address((ip or "").strip())
        return not (a.is_private or a.is_loopback or a.is_link_local or a.is_multicast or a.is_reserved)
    except ValueError:
        return False
def quick_block_link(e, ip):
    """Lien signé 'Bloquer l'IP' -> SOAR. IP PUBLIQUE uniquement. TTL court (24h) :
    action plus sensible que le FP -> on limite la fenêtre de rejeu d'un lien fuité."""
    secret = e.get("QUICK_SECRET", "")
    ip = (ip or "").strip()
    if not secret or not is_public_ip(ip): return ""
    exp = int(time.time()) + 86400
    p = urllib.parse.urlencode({"a": "block", "e": ip, "tag": "",
                                "exp": exp, "sig": quick_sign(secret, "block", ip, "", exp)})
    return f"{GL_BASE}/m/api/quick?{p}"

