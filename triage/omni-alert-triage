def send_mail(e, ctx, decision_reason):
    host = e.get("SMTP_HOST","smtp-internal.omnitech-security.fr")
    port = int(e.get("SMTP_PORT","25"))
    frm  = e.get("SMTP_FROM","no-reply@omnitech-security.fr")
    to   = [x.strip() for x in e.get("MAIL_RECIPIENTS","informatique@omnitech-security.fr").split(",") if x.strip()]
    pfx  = e.get("SMTP_SUBJECT_PREFIX","[SIEM OMNITECH]")
    soc  = e.get("OMNI_SOC_URL","https://bx-it-graylog-vm.omnitech.security/soc/")
    level = sev_label(ctx['tier'], decision_reason)
    titre = re.sub(r"^OMNI\s*-\s*", "", ctx['titre'])   # titre epure
    _lv = level.lower()
    color = "#b42318" if ("critique" in _lv or "incident" in _lv) else "#d97706"  # rouge profond / ambre
    site  = ctx.get('site', '-')
    g     = guidance(guidance_key(ctx.get('tag', ''), ctx.get('titre', '')))
    why   = rationale(ctx['tier'], decision_reason, ctx['score'])
    ent_short = (ctx.get('entite', '') or '').split('=', 1)[-1].split('\\')[-1].strip()
    if ent_short in ('-', ''): ent_short = ''
    # bouton FP sur tout ce qui N'EST PAS critique : un CRITIQUE ne peut JAMAIS etre mis en
    # sourdine, mais un NOISE escalade par le score merite le bouton (c'est justement le bruit
    # que l'analyste veut faire taire). quick_fp_link exige deja un tag -> pas de sourdine large.
    fp_link = quick_fp_link(e, ctx.get('entite', ''), ctx.get('tag', '')) if ctx.get('tier') != 'CRITICAL' else ""
    # bouton 'Bloquer l'IP' : 1re IP PUBLIQUE de l'alerte (src puis dest) ; tous tiers
    block_link = quick_block_link(e, next((ip for ip in (ctx.get('src_ip', ''), ctx.get('dest_ip', '')) if is_public_ip(ip)), ""))
    # deep-link console -> dossier 360 de l'entite
    soc_deep = soc + ("#e=" + urllib.parse.quote(ctx['entite']) if ctx.get('entite') and ctx['entite'] not in ('-', '') else "")
    # fallback texte brut (clients sans HTML)
    body = (f"Alerte {level} retenue par le triage SIEM.\n\n"
            f"  Alerte   : {titre}\n")
    if ctx.get("desc"):     body += f"  Contexte : {ctx['desc']}\n"
    _ent_lab, _ent_val = _entity_label(ctx.get('entite'))
    if ctx.get('entite') not in ('-', '', None):
        body += f"  {_ent_lab:<9}: {_ent_val}" + (f"   (site {site})" if site not in ('-', '') else "") + "\n"
    _grav = f"  Gravite  : {level}  (score {ctx['score']}/100)"
    if ctx.get("risk_sev") and ctx.get("risk_sev") not in ("none", "-"):
        _grav += f"  [risque {ctx['risk_sev']}" + (f" {ctx['risk_score']}/10" if ctx.get('risk_score') not in ('',None) else "") + "]"
    body += _grav + "\n"
    _ip = ctx.get("src_ip") or ctx.get("dest_ip")
    if _ip and str(_ip) != _ent_val: body += f"  IP       : {_ip}" + (f" ({_pays(ctx['country'])})" if ctx.get('country') else "") + (" - reputee malveillante" if ctx.get('ti') else "") + "\n"
    if ctx.get("user") and str(ctx["user"]) != _ent_val: body += f"  Compte   : {ctx['user']}\n"
    if ctx.get("host") and str(ctx["host"]) != _ent_val and ctx["host"] != ctx.get("entite",""): body += f"  Hote     : {ctx['host']}\n"
    if ctx.get("net"):    body += f"  Reseau   : {ctx['net']}\n"
    # Bloc SEAL (surete physique) symetrique du HTML : le corps texte doit dire la
    # meme chose (ou / quelle porte / quel badge), sinon un MUA texte-seul perd le OU.
    if ctx.get("seal_site"):
        body += f"  Site     : {ctx['seal_site']}\n"
        if ctx.get("seal_zone"):   body += f"  Zone     : {ctx['seal_zone']}\n"
        if ctx.get("seal_porte"):  body += f"  Porte    : {ctx['seal_porte']}\n"
        if ctx.get("seal_badge"):  body += f"  Badge    : {ctx['seal_badge']}\n"
        if ctx.get("seal_action"): body += f"  Evt SEAL : {ctx['seal_action']}\n"
    if ctx.get("dest_port"): body += f"  Port     : {ctx['dest_port']}\n"
    if ctx.get("dns_name"):
        body += f"  DNS enr. : {ctx['dns_name']}" + (f" ({ctx['dns_type']})" if ctx.get('dns_type') else "") + "\n"
        if ctx.get("dns_zone"): body += f"  Zone DNS : {ctx['dns_zone']}\n"
    _cnt = ctx.get("count")
    if ctx.get("count_reel") and str(_cnt) not in ("0", "0.0"):
        body += f"  Occurr.  : {_cnt} sur la fenetre\n"
    elif ctx.get("count_reel"):
        body += f"  Constat  : aucun evenement recu sur la fenetre (flux muet)\n"
    elif _cnt:
        try: _many = int(float(_cnt)) >= 5
        except Exception: _many = False
        body += f"  Evenements: {_cnt}" + (" (echantillon, plafond notif)\n" if _many else " joint(s)\n")
    if ctx.get("threat"):
        body += f"  Menace   : {ctx['threat']}" + (f" ({ctx['threat_type']})" if ctx.get('threat_type') else "") + "\n"
        if ctx.get("av_object"):  body += f"  Objet    : {ctx['av_object']}\n"
        if ctx.get("av_process"): body += f"  Process  : {ctx['av_process']}\n"
        if ctx.get("av_action"):
            _rem = (ctx.get('av_remediated','') or '').lower()
            _suf = " (neutralisee)" if _rem in ("true","1","oui") else " (NON remediee - a traiter)" if _rem in ("false","0","non") else ""
            body += f"  Action AV: {ctx['av_action']}{_suf}\n"
    if ctx.get("priority") not in ("", None): body += f"  Priorite : {ctx['priority']}\n"
    if ctx.get("ts"):       body += f"  Quand    : {ctx['ts']} UTC\n"
    body += f"  Signaux  : {', '.join(ctx['signaux']) or '-'}\n"
    if ctx.get("mitre_tech"):
        _mt = ctx["mitre_tech"] + (f" - {ctx['mitre_name']}" if ctx.get("mitre_name") else "")
        body += f"  MITRE    : {_mt}" + (f"  ({ctx['mitre_tac']})" if ctx.get("mitre_tac") else "") + "\n"
    body += f"  Recu car : {why}\n\n"
    bl = ctx.get("backlog") or []
    if bl:
        body += "  Evenements declencheurs :\n"
        for i, b in enumerate(bl):
            body += f"   * {b['ts']} | {b['src']} | {b['msg']}\n"
            if i < 3 and b.get("raw"):
                lt = _format_log_text(b["raw"])
                if lt: body += lt + "\n"
        body += "\n"
    else:
        _dt = _format_log_text(ctx.get('message', '')) or str(ctx.get('message', '')).strip()
        if _dt:   # pas de "Detail : -" vide (incident kill-chain sans log joint)
            body += "  Detail :\n" + _dt + "\n\n"
    if g:
        body += ("  Guide d'action :\n"
                 f"   - Ce que c'est : {g.get('ce_que_cest','')}\n"
                 f"   - A verifier   : {g.get('a_verifier','')}\n"
                 f"   - Remediation  : {g.get('remediation','')}\n"
                 f"   - Correction   : {g.get('correction','')}\n\n")
    body += f"  Console : {soc}\n"
    if ctx.get("replay"):   body += f"  Logs Graylog : {ctx['replay']}\n"
    if block_link:          body += f"  Bloquer l'IP : {block_link}\n"
    if fp_link:             body += f"  Marquer faux positif : {fp_link}\n"
    body += "-- Triage automatique (omni-alert-triage).\n"
    msg = MIMEMultipart("alternative")
    # sujet encode RFC 2047 (accents corrects sur tous les MUA) ; pas d'emoji
    subj = f"{pfx} {level} — {titre}" + (f" · {ent_short}" if ent_short else "")
    msg["Subject"] = Header(subj, "utf-8")
    msg["From"] = frm; msg["To"] = ", ".join(to)
    msg.attach(MIMEText(body, "plain", "utf-8"))
    msg.attach(MIMEText(_mail_html(titre, level, color, ctx, site, g, soc_deep, why, fp_link, block_link), "html", "utf-8"))
    with smtplib.SMTP(host, port, timeout=15) as s:
        s.sendmail(frm, to, msg.as_string())

def bump(d, decision):
    c = d.setdefault("stats", {}); c[decision] = c.get(decision, 0) + 1

# --- FP dynamiques : suppression de mail apprise (analyste /soc/, script, RSSI) -
# Sûr par construction : scope (entite + sous-chaine de titre optionnelle), TTL,
# JAMAIS appliquee a un CRITICAL, et chaque suppression est tracee (GELF fp_drop).
FP_FILE = "/var/lib/omni-alert-triage/fp.json"
def load_fp():
    try: return json.load(open(FP_FILE))
    except Exception: return []
def save_fp(lst):
    os.makedirs(os.path.dirname(FP_FILE), exist_ok=True)
    tmp = FP_FILE + ".tmp"; json.dump(lst, open(tmp, "w")); os.replace(tmp, FP_FILE)
def fp_active(now):
    return [r for r in load_fp() if r.get("until", 0) > now]
def fp_match(rules, title, entity, tag=""):
    tl = (title or "").lower(); tg = (tag or "").lower()
    for r in rules:
        ent = r.get("entity", "")
        if not ent or ent not in (entity or ""):
            continue
        rtag = (r.get("tag", "") or "").lower()
        sub  = (r.get("title_sub", "") or "").lower()
        # precision decroissante : tag exact (1 detection) > sous-chaine titre > entite seule
        if rtag:
            if rtag == tg: return r
        elif sub:
            if sub in tl: return r
        else:
            return r
    return None

class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def _json(self, code, obj):
        self.send_response(code); self.send_header("Content-Type", "application/json")
        self.end_headers(); self.wfile.write(json.dumps(obj).encode())
    def _auth_ok(self, e):
        tok = e.get("TRIAGE_TOKEN", "")
        return (not tok) or self.headers.get("X-Triage-Token", "") == tok
    def do_GET(self):
        if self.path.startswith("/stats"):
            self._json(200, load().get("stats", {})); return
        if self.path.startswith("/fp"):
            self._json(200, fp_active(time.time())); return
        self.send_response(404); self.end_headers()
    def do_DELETE(self):
        e = env()
        if not self._auth_ok(e): self.send_response(403); self.end_headers(); return
        from urllib.parse import urlparse, parse_qs
        ent = (parse_qs(urlparse(self.path).query).get("entity") or [""])[0]
        lst = [r for r in load_fp() if r.get("entity") != ent]; save_fp(lst)
        self._json(200, {"ok": True, "removed_entity": ent, "restant": len(lst)})
    def do_POST(self):
        e = env()
        if not self._auth_ok(e):
            self.send_response(403); self.end_headers(); return   # secret partage requis
        try:
            n = int(self.headers.get("Content-Length", 0))
            payload = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            self.send_response(400); self.end_headers(); return
        # --- gestion des FP dynamiques (ex: /soc/ marque un faux positif) ---
        if self.path.startswith("/fp"):
            ent = str(payload.get("entity", "")).strip()
            if not ent: self._json(400, {"error": "champ 'entity' requis (ex: src_ip=1.2.3.4)"}); return
            days = int(payload.get("ttl_days", e.get("FP_DEFAULT_TTL_DAYS", "30")))
            now = time.time()
            rtag = str(payload.get("tag", ""))[:60]
            rule = {"entity": ent, "tag": rtag, "title_sub": str(payload.get("title_sub", "")),
                    "until": now + days*86400, "by": str(payload.get("by", "?"))[:60]}
            lst = [r for r in load_fp() if r.get("until", 0) > now
                   and not (r.get("entity") == ent and (r.get("tag", "") or "") == rtag)]
            lst.append(rule); save_fp(lst)
            gelf("fp_add", ent, "-", 0, [rtag or rule["title_sub"] or "*"], f"soc_fp par {rule['by']} ttl={days}j scope={rtag or rule['title_sub'] or 'entite'}")
            self._json(200, {"ok": True, "rule": rule, "actifs": len(lst)}); return
        crit, noise = tiers()
        ev = payload.get("event") or {}
        f  = fields_of(payload)
        title = ev.get("event_definition_title") or payload.get("event_definition_title","")
        entity = entity_of(f, ev)
        tier = classify(title, crit, noise)
        now = time.time(); d = load()
        # --- POLITIQUE QA (transverse SEAL) : bx-qa-seal-vm est un systeme de TEST.
        # Ses alertes ne remontent JAMAIS par mail (console/Teams au pire). Teams
        # reste cable en direct dans Graylog (firehose SOC) et /soc/ voit toujours
        # l'evenement ; on coupe uniquement la voie MAIL du triage. PROD (bx-seal-omega)
        # est inchange. seal_site est pose par Logstash (add_field), present a ~99,9%
        # sur les fenetres de detection (10-15 min, cf. seal/docs/FAUX-POSITIFS.md) et
        # injecte dans le group_by + field_spec de chaque def SEAL a group_by non vide
        # (seal/detections/provision_detections.py l.338-350) -> present sur le payload
        # ET sur le backlog : cle de routage fiable. AUCUNE exception (meme ALM-003
        # intrusion : sur le site de test, c'est un essai, pas une effraction).
        # Match sur seal_site (evenements a group_by) OU sur le TITRE : les detections
        # SEAL "Flux interrompu" se declenchent sur une ABSENCE d'evenements (count=0),
        # donc l'evenement ne porte PAS seal_site -- le site n'est que dans le titre
        # (ex. "... sur site bx-qa-seal-vm"). Sans ce 2e test, 36% des mails etaient du
        # bruit du systeme de TEST (audit 23/07/2026 : 213 mails/7j).
        _qa_site = e.get("SEAL_QA_SITE", "bx-qa-seal-vm")
        _qa_hit = "seal_site" if f.get("seal_site", "") == _qa_site else ("titre" if _qa_site and _qa_site in (title or "") else "")
        if _qa_site and _qa_hit:
            bump(d, "qa_console"); save(d)
            gelf("qa_console", title, tier, 0, [_qa_hit + "=" + _qa_site],
                 "site_test:" + _qa_site + " (via " + _qa_hit + ") -> console/Teams, mail supprime")
            self.send_response(200); self.end_headers()
            self.wfile.write(json.dumps({"decision": "qa_console", "tier": tier,
                "score": 0, "reason": "qa_test:" + _qa_site}).encode())
            return
        # Correlation fil de l'eau : chaque alerte alimente TOUTES ses cles
        # canoniques (identite/machine/IP/badge) des sa reception ; la kill-chain
        # retient la cle la plus corroboree. Cross-source : une connexion console
        # SEAL et une force brute Windows sur le meme compte se rejoignent enfin.
        ckeys = corr_keys(f, ev, entity)
        vel, corr_key, corr_hist = velocity_multi(
            d, ckeys, title, now, int(e.get("KILLCHAIN_WINDOW", "1800")))
        score, signals = score_alert(e, tier, f, ev, entity, vel)
        bl = payload.get("backlog") or []
        excerpt = ""
        if bl and isinstance(bl[0], dict):
            mm = bl[0].get("message") if isinstance(bl[0].get("message"), dict) else bl[0]
            excerpt = (mm.get("message") if isinstance(mm, dict) else str(mm)) or ""
        # Alertes correlees a afficher : les AUTRES types vus sur la meme cle dans la
        # fenetre (la courante est deja le sujet du mail), de la plus recente a la
        # plus ancienne. C'est le "pourquoi c'est un incident et pas une alerte".
        corr_rows, _seen = [], {title}
        for _t, _ts in reversed(corr_hist):
            if _t in _seen: continue
            _seen.add(_t)
            corr_rows.append((time.strftime("%d/%m %H:%M", time.localtime(_ts)),
                              re.sub(r"^OMNI\s*-\s*", "", str(_t))))
            if len(corr_rows) >= 6: break
        # Vrai volume agrege (pas la taille du backlog joint, plafonne par Graylog).
        _cnt, _cnt_reel = real_count(ev, len(payload.get("backlog") or []))
        ctx = {"titre":title,"entite":entity,"tier":tier,"score":score,"signaux":signals,
               "tag":f.get("alert_tag",""),"site":f.get("fortigate_site","-"),"velocite":vel,
               "corr_key":corr_key,"corr_rows":corr_rows,
               # --- contexte SEAL (surete physique) : sans ces champs, une alerte
               # d'intrusion physique arrivait sans dire NI ou NI quel badge.
               "seal_site":f.get("seal_site",""),
               "seal_zone":f.get("seal_zone",""),
               "seal_porte":f.get("trigger_code","") or f.get("target_object_label","")
                            or f.get("target_object_id",""),
               "seal_badge":f.get("badge_number",""),
               "seal_reev":f.get("REEV_CODE",""),
               "seal_action":f.get("event_action",""),
               "message":str(excerpt)[:600],
               "desc":_analyst_desc(payload.get("event_definition_description","")),
               "ts":str(ev.get("timestamp",""))[:19].replace("T"," "),
               "priority":ev.get("priority",""), "replay":replay_url(ev),
               "backlog":backlog_rows(payload),
               # MITRE : si le pipeline n'a pas pose mitre_technique (detections M365
               # legacy/appareil, VPN... sans alert_tag -> lookup non applique), on le
               # RECONSTRUIT depuis le titre qui annonce deja "T1078.004" / "(T1098.005)".
               # Sinon le badge ATT&CK manquait alors que le titre le promet (audit 13/08).
               "mitre_tech":f.get("mitre_technique","") or (_TECH_RE.search(title).group(0) if _TECH_RE.search(title or "") else ""),
               "mitre_name":f.get("mitre_technique_name",""),
               "mitre_tac":f.get("mitre_tactic",""),
               # Pays : les detections GEO (ueba_geo) portent le pays dans geo_new_*/
               # geo_to_* et PAS dans *_ip_country_code -> sans ces fallbacks, deux
               # detections DE PAYS n'affichaient aucun pays (audit 13/08/2026).
               "country":_first(f,"src_ip_country_code","dest_ip_country_code",
                                "geo_new_ip_country_code","geo_new_country",
                                "geo_to_ip_country_code","remip_country_code"),
               # IP / compte / hote : fallbacks multi-sources (Forti, Linux, Aruba, Entra,
               # geo/VPN). 'remip'/'geo_new_ip'/'geo_to_ip' = IP etrangere reelle des
               # alertes VPN/geo (sinon "VPN depuis l'etranger" n'affichait NI IP NI pays).
               "src_ip":_first(f,"src_ip","srcip","client_ip","remote_ip","clientip",
                               "geo_new_ip","geo_to_ip","geo_from_ip","remip"),
               "dest_ip":_first(f,"dest_ip","dstip","dst_ip"),
               "user":_first(f,"user","eset_username","upn","actor_login","identity","identity_console",
                             "winlogbeat_winlog_event_data_TargetUserName","samaccountname","usr"),
               # 'devname'/'dvchost' RETIRES du fallback hote : ce sont les noms de
               # l'APPLIANCE FortiGate (ex. OMNITECH-BDX_FG120G), jamais le poste
               # concerne -> "VPN depuis l'etranger" affichait le pare-feu comme
               # 'Hote' (trompeur, audit 13/08/2026). Mieux vaut aucune ligne Hote.
               "host":_first(f,"host","eset_hostname","entity_host","computer","hostname"),
               "net":f.get("net_segment",""), "dest_port":_first(f,"dest_port","dstport","dport"),
               "count":_cnt, "count_reel":_cnt_reel,
               # Score de risque metier (pose par les robots UEBA/geo : risk_severity
               # 'critique'/'eleve', risk_score 0-10). Sans LLM, un impossible travel
               # 'critique' arrivait libelle "A VERIFIER 75/100" -> on remonte le vrai
               # niveau (audit 13/08/2026).
               "risk_sev":str(_first(f,"risk_severity") or "").lower(),
               "risk_score":_first(f,"risk_score"),
               # DNS (canal audit Windows DNS) : QUEL enregistrement / zone a change.
               "dns_name":_first(f,"dns_name","query_name","qname"),
               "dns_zone":f.get("dns_zone",""),
               "dns_type":_first(f,"dns_query_type","query_type","qtype"),
               # FortiGate IPS : la signature est dans 'attack' (ex. PHP.Malicious.Shell)
               # -> sans ce fallback, ~93% des hits IPS s'affichaient SANS nom de menace
               # (audit 13/08/2026). 'attack' place avant 'msg' (jamais le message brut).
               "threat":_first(f,"eset_threat_name","virus","forticlient_virus","threat",
                               "malware_name","attack_name","attack"),
               "threat_type":_first(f,"eset_threat_type","threat_type","attack_type"),
               # AV : fallbacks non-ESET (FortiClient/generique) -- fichier/processus/action.
               "av_object":_first(f,"eset_object_uri","eset_target","filepath","filename","file",
                                  "quarantinedfilepath","object","uri"),
               "av_process":_first(f,"eset_processname","process","processname","proc","image"),
               "av_action":_first(f,"eset_action_taken","eset_action","action","av_action","status","quarantine"),
               "av_remediated":str(_first(f,"eset_threat_handled","remediated","quarantined","handled") or ""),
               "ti":(str(f.get("src_ip_threat_indicated","")).lower()=="true"
                     or str(f.get("dest_ip_threat_indicated","")).lower()=="true")}

        mail_thr = int(e.get("MAIL_SCORE_THRESHOLD","80"))
        # Sans LLM, la zone grise est CONSERVATRICE : ne maile que sur forte
        # corroboration (actif critique + threat-intel + prio...). Le vrai tri fin
        # de la zone grise = activer ANTHROPIC_API_KEY.
        gray_thr = int(e.get("GRAY_SCORE_THRESHOLD","90"))
        decision, reason = "drop", tier.lower()

        fp = {x.strip() for x in e.get("TRIAGE_FP_ENTITIES","").split(",") if x.strip()}
        dyn_rule = fp_match(fp_active(now), title, entity, f.get("alert_tag", ""))   # FP appris (/soc/, script...)
        kth = int(e.get("KILLCHAIN_COUNT","4"))
        want_mail = False
        if entity in fp:                       # match EXACT (avant : sous-chaine ->
            decision, reason = "drop", "fp_connu"  # .13 muait .130/.131 et pouvait tuer un CRITICAL)
        elif vel >= kth and corr_key:
            # corr_key exclut deja 'source=' (hote d'ORIGINE du log, present sur toutes
            # les alertes de sante internes Disque/Backup/Rapport/Robot/Cert : elles
            # retombaient toutes sur source=bx-it-graylog-vm et fabriquaient une fausse
            # kill-chain -> mail force). On ne correle jamais sur 'source'. (audit 06/07/2026)
            want_mail, reason = True, f"killchain_escalade(x{vel} types/{corr_key})"
            # Incident correle reinjecte dans le SIEM : trace la kill-chain elle-meme
            # (et pas seulement les alertes unitaires) -> chasse + tableau de bord.
            corr_gelf(corr_key, vel, corr_hist, title, score)
        elif tier == "CRITICAL":
            want_mail, reason = True, "critical"   # CRITICAL jamais supprime par un FP appris
        elif dyn_rule:
            decision, reason = "drop", f"fp_soc({dyn_rule.get('by','?')})"
        elif tier == "NOISE":
            if score >= mail_thr: want_mail, reason = True, f"noise_escalade(score={score})"
            else: decision, reason = "drop", f"noise(score={score})"
        else:  # GRAY
            rel, why = llm_relevant(e, ctx); reason = why
            if rel is True: want_mail = True
            elif rel is False: decision = "drop"
            else:  # juge indisponible -> score, puis defaut fail-safe DOCUMENTE
                if score >= gray_thr:
                    want_mail, reason = True, f"{why}|score={score}"
                elif why.startswith("llm_erreur") and e.get("OMNI_TRIAGE_GRAY_DEFAULT","drop").lower() == "mail":
                    # Cle presente mais appel API en echec transitoire -> fail-open documente
                    # (OMNI_TRIAGE_GRAY_DEFAULT=mail) pour ne PAS perdre une alerte grise faute
                    # de juge. N'agit PAS quand la cle est absente (why=llm_absent) : aucun flood
                    # tant que le LLM n'est pas active. Corrige une config jusqu'ici jamais lue.
                    want_mail, reason = True, f"{why}|gray_default=mail"
                else:
                    decision, reason = "drop", f"{why}|score={score}<{gray_thr}"

        win = int(e.get("TRIAGE_DEDUP_SECONDS","3600"))
        if want_mail:
            # Filet de securite dedup : si l'entite primaire est un 'source=' (collecteur,
            # pas le sujet), on deduplique plutot sur la 1re cle de correlation (ckeys
            # exclut deja 'source=' par construction) -> deux sujets distincts collectes
            # par le meme hote ne s'ecrasent plus. Sinon comportement inchange.
            key = "dedup:" + title + "|" + (ckeys[0] if entity.startswith("source=") and ckeys else entity)
            if key in d and (now - d[key]) < win:
                decision, reason = "dedup", reason + "+dedup"
            else:
                try:
                    send_mail(e, ctx, reason); decision = "mail"; d[key] = now
                except Exception as ex:
                    decision, reason = "mail_echec", f"{reason}|smtp:{type(ex).__name__}"
        # purge dedup expires : borne par win (sinon un TRIAGE_DEDUP_SECONDS > 24h etait
        # ecrase par le plafond en dur -> re-mail premature). stats + save.
        _ddl = max(win, 86400)
        d = {k:v for k,v in d.items() if not (k.startswith("dedup:") and now - v > _ddl)}
        # purge des compteurs de velocite (vel:<entite>) dont AUCUNE entree n'est dans la
        # fenetre 7j -> evite la croissance non bornee de state.json (1 cle par entite vue).
        _velmax = 7 * 86400
        d = {k: v for k, v in d.items() if not (
            k.startswith("vel:") and isinstance(v, list)
            and not any(isinstance(x, (list, tuple)) and len(x) == 2
                        and (now - (x[1] or 0)) < _velmax for x in v))}
        bump(d, decision); save(d)
        gelf(decision, title, tier, score, signals, reason)
        self.send_response(200); self.end_headers()
        self.wfile.write(json.dumps({"decision":decision,"tier":tier,"score":score,"reason":reason}).encode())

