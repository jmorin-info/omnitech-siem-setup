    if g:
        corps += M3.section("Guide d'action complet", M3.faits([("Ce que c'est", esc(g.get("ce_que_cest", ""))), ("À vérifier", esc(g.get("a_verifier", ""))),
                                                                 ("Remédiation", esc(g.get("remediation", ""))), ("Correction durable", esc(g.get("correction", "")))]))
    tech = [("Entité", f"<code>{esc(ctx.get('entite'))}</code>"), ("Règle", esc(regle_id or regle_txt)),
            ("Signaux", esc(", ".join(ctx.get("signaux") or []))), ("Décision", esc(decision_reason)),
            ("Priorité", esc(ctx.get("priority"))), ("Horodatage UTC", esc(ctx.get("ts"))), ("Étiquette", esc(ctx.get("tag")))]
    corps += M3.section("Données techniques", M3.faits(tech))
