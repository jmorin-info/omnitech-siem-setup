def classify(title, crit, noise):
    t = (title or "").lower()
    for rx in crit:
        if re.search(rx, t): return "CRITICAL"
    for rx in noise:
        if re.search(rx, t): return "NOISE"
    return "GRAY"

def fields_of(payload):
    ev = payload.get("event") or {}
    f = dict(ev.get("fields") or {})
    for m in (payload.get("backlog") or [])[:3]:
        if isinstance(m, dict):
            mm = m.get("message") if isinstance(m.get("message"), dict) else m
            if isinstance(mm, dict):
                for k, v in mm.items():
                    f.setdefault(k, v)
    return f

_EMPTY = ("", "-", "(empty value)", "n/a", "null", "none", "unknown", "?")
def _blank(v):
    """True si valeur vide/sentinelle, INSENSIBLE A LA CASSE ('N/A', 'NONE',
    'Null' comptent comme vides -- audit 13/08/2026 : les logs Forti/geo portent
    'N/A' en majuscules)."""
    return v is None or str(v).strip().lower() in _EMPTY
def _first(f, *keys):
    """1re valeur non vide parmi plusieurs noms de champ possibles. Permet au mail
    de rester complet quelle que soit la source (ESET vs FortiClient, Windows vs
    Linux/Aruba/Entra) sans coder un cas par source."""
    for k in keys:
        v = f.get(k)
        if not _blank(v):
            return v
    return ""

# La 'description' d'une event definition sert souvent de NOTE DE BUILD interne
# (ex. "P3 - provisionne par 13-graylog-alerts.sh", "clone 02/07/2026",
# "desactive (recette)", "90-fortiems.sh"). La rendre comme "Contexte" analyste
# est incoherent, contradictoire (une alerte live decrite "desactivee") et fuit
# les noms de scripts internes. Si la desc matche ces marqueurs -> on n'affiche
# rien (le mail garde titre + faits + guide d'action + backlog). Audit 13/08/2026.
_BUILD_NOISE = re.compile(r"provisionn[ée]|\.sh\b|\.py\b|clone\s+\d|"
                          r"d[ée]sactiv[ée].{0,4}\(recette\)|^\s*P\d\b|\bcf\s+\d", re.I)
def _analyst_desc(s):
    s = (s or "").strip()
    return "" if (not s or _BUILD_NOISE.search(s)) else s

# --- Vrai volume agrege vs taille de l'echantillon joint ----------------------
_COUNT_RE = re.compile(r"\b(?:count\(\)|sum\([^)]*\)|card\([^)]*\))\s*=\s*([0-9]+(?:\.[0-9]+)?)")
def real_count(ev, n_backlog):
    """Le VRAI nombre d'occurrences agregees, PAS la taille de l'echantillon joint.
    Graylog plafonne le backlog a notification_settings.backlog_size (souvent 5) :
    len(backlog) n'a AUCUN rapport avec le compte reel (facteur de minoration mesure
    jusqu'a 124x). Le compte reel est deja dans le payload (event.message =
    '... - count()=161.0', ou aggregation_conditions.count) mais n'etait lu nulle
    part. Renvoie (valeur, est_reel) ; a defaut, l'echantillon avec est_reel=False
    pour un libelle honnete. Jamais d'exception : on ne peut pas faire pire que
    l'etat actuel qui affiche deja l'echantillon."""
    ac = ev.get("aggregation_conditions")
    v = ac.get("count") if isinstance(ac, dict) else None
    if v is None:
        m = _COUNT_RE.search(str(ev.get("message") or ""))
        v = m.group(1) if m else None
    try:
        return int(float(v)), True
    except Exception:
        return n_backlog, False

def _noise_subject(v):
    """True si 'v' est un compte MACHINE ($) ou SYSTEM/service, donc PAS le sujet
    d'une alerte (le vrai sujet est l'hote). Couvre les formats FR/EN et domaines
    avec espace que _canon_user ne strippe pas ('AUTORITE NT\\Systeme'). Sert
    UNIQUEMENT au choix d'entite d'affichage (audit 13/08/2026)."""
    s = str(v or "").strip()
    if not s:
        return True
    short = re.split(r"[\\/]", s)[-1].strip().lower()  # part apres le domaine
    if short.endswith("$"):                            # compte machine
        return True
    return short in ("system", "système", "systeme", "anonymous logon",
                     "local service", "network service", "local system", "-")

def entity_of(f, ev):
    # Entite PRIMAIRE : sert au dedup, aux regles de FP apprises (/soc/) et a
    # l'affichage ("Concerne"). Format ("cle=valeur") et ordre des 3 PREMIERES cles
    # (src_ip, user, host) volontairement INCHANGES : les regles de FP en base sont
    # indexees dessus (ex. "src_ip=1.2.3.4").
    # AJOUT 'upn' (audit 17/07/2026) : les detections Entra/M365 portent le sujet
    # dans 'upn' et nulle part ailleurs ; entity_of l'ignorait -> plusieurs UPN
    # distincts tombaient sur la meme cle de dedup et s'ecrasaient dans la fenetre.
    # RELEGATION de 'source' (hote d'ORIGINE du log, champ obligatoire Graylog)
    # APRES key_tuple, en dernier recours : 'source' n'est jamais le SUJET d'une
    # alerte, c'est le collecteur. Il preemptait le repli key_tuple (ex. SEAL).
    for k in ("src_ip", "user", "host", "upn", "dest_ip", "srcip"):
        v = f.get(k)
        if not v:
            continue
        # 'user' = compte MACHINE ($) ou SYSTEM/ANONYMOUS n'est PAS le sujet d'une
        # alerte : ex. "ransomware: suppression shadow copies" par AUTORITE NT\
        # Systeme -> le vrai sujet est l'HOTE. On saute vers host au lieu d'afficher
        # "Systeme" comme entite (audit 13/08/2026). _canon_user neutralise deja
        # ces comptes (renvoie "").
        if k == "user" and _noise_subject(v):
            continue
        return f"{k}={v}"
    # key_tuple : retirer les elements VIDES avant le join (sinon entite
    # "bx-seal-omega,34D1022962C00000," avec virgule finale quand un membre du
    # group_by est vide, ex. target_object_id="" sur SEAL ACC-008 - audit 13/08).
    kt = [str(x) for x in (ev.get("key_tuple") or []) if str(x).strip() not in ("", "-")]
    if kt: return ",".join(kt)
    v = f.get("source")
    if v: return f"source={v}"
    return "-"

# --- Correlation FIL DE L'EAU : cles transverses ------------------------------
# Probleme resolu : l'entite primaire prend le PREMIER champ trouve (src_ip en
# tete). Une meme personne apparait donc sous des cles differentes selon la
# source -- "user=jmorin" cote M365, "src_ip=..." cote FortiGate, key_tuple cote
# SEAL -- et les alertes qui la concernent ne se correlaient JAMAIS entre elles.
# On calcule ici TOUTES les cles canoniques d'une alerte (identite, machine, IP,
# badge) ; la kill-chain se declenche des qu'UNE de ces cles cumule assez de
# types d'alertes distincts. Additif : l'entite primaire ne change pas.
_USER_RE = re.compile(r'^(?:[\w.-]+\\)?([^@\\]+?)(?:@[\w.-]+)?$')

def _canon_user(v):
    """Forme canonique d'un compte, tous formats confondus :
       'SECURITY\\RETEVENARD', 'retevenard@omnitech.security', 'retevenard'
       -> 'retevenard'. C'est ce qui permet a une connexion console SEAL et a une
       force brute Windows sur le MEME compte de se rejoindre."""
    s = str(v or "").strip()
    if not s or s.lower() in ("-", "n/a", "(empty value)", "null", "none"): return ""
    m = _USER_RE.match(s)
    s = (m.group(1) if m else s).strip().lower()
    # comptes techniques omnipresents : correler dessus fabriquerait une
    # kill-chain permanente reliant des incidents sans rapport.
    return "" if s in ("system", "anonymous logon", "local service",
                       "network service", "-", "") else s

_USER_FIELDS = ("identity", "identity_console", "identity_upn", "actor_login", "user", "entity_user",
                "upn", "winlogbeat_winlog_event_data_TargetUserName", "eset_username",
                "target_login", "actor_usercode")
_HOST_FIELDS = ("host", "eset_hostname", "entity_host", "computer", "devname", "dark_host", "cert_machine")
_IP_RE = re.compile(r"^\d{1,3}(?:\.\d{1,3}){3}$")   # IPv4 litterale (pas un FQDN)

def corr_keys(f, ev, primary):
    """Cles de correlation d'une alerte (fil de l'eau, cross-source)."""
    keys = []
    for k in _USER_FIELDS:
        u = _canon_user(f.get(k))
        if u: keys.append("user=" + u); break
    for k in _HOST_FIELDS:
        h = str(f.get(k) or "").strip().lower()
        if h and h not in ("-", "(empty value)"):
            # FQDN et nom court = meme machine -> on tronque au 1er label. MAIS une IP
            # litterale n'est pas un FQDN : la tronquer produisait "host=10" et fusionnait
            # 115 equipements 10.x sur une seule cle (audit 17/07/2026). On la garde entiere.
            keys.append("host=" + (h if _IP_RE.match(h) else h.split(".")[0])); break
    for k in ("src_ip", "srcip"):
        v = str(f.get(k) or "").strip()
        if v: keys.append("src_ip=" + v); break
    b = str(f.get("badge_number") or "").strip()
    if b: keys.append("badge=" + b)
    # repli : l'entite primaire, sauf 'source=' (hote d'origine du log, present sur
    # TOUTES les alertes de sante internes -> fausse kill-chain, cf. audit 06/07).
    if not keys and primary and primary != "-" and not primary.startswith("source="):
        keys.append(primary)
    return list(dict.fromkeys(keys))   # dedup ordonne : une cle calculee 2x polluerait l'historique

def velocity(d, entity, title, now, window):
    """Kill-chain : nb de TYPES d'alertes distincts sur cette entite dans la
    fenetre (5x la meme alerte = 1, mais 4 detections differentes = signal fort)."""
    vk = "vel:" + entity
    # robuste aux anciens formats d'etat (entrees float) : on ne garde que les paires
    hist = [x for x in d.get(vk, []) if isinstance(x, (list, tuple)) and len(x) == 2 and now - x[1] < window]
    hist.append([title, now]); d[vk] = hist[-50:]
    return len({x[0] for x in hist})

def velocity_multi(d, keys, title, now, window):
    """Applique velocity() a chaque cle de correlation et retient la plus forte.

    Renvoie (nb_types_max, cle_gagnante, historique_trie). L'historique alimente
    le bloc "Alertes correlees" du mail : sans lui, le mail annoncait une
    kill-chain sans jamais dire de QUOI elle etait faite."""
    best_n, best_key, best_hist = 0, "", []
    for k in keys:
        n = velocity(d, k, title, now, window)
        if n > best_n:
            best_n, best_key = n, k
            best_hist = [x for x in d.get("vel:" + k, [])
                         if isinstance(x, (list, tuple)) and len(x) == 2]
    return best_n, best_key, sorted(best_hist, key=lambda x: x[1])

def score_alert(e, tier, f, ev, entity, vel):
    sc = {"CRITICAL":100, "GRAY":50, "NOISE":10}[tier]
    # tier francise dans les "Signaux" affiches (plus de "gray"/"noise" anglais
    # expose a l'analyste dans le mail - audit 13/08/2026).
    sig = [{"CRITICAL":"critique", "GRAY":"zone_grise", "NOISE":"bruit"}.get(tier, tier.lower())]
    pr = ev.get("priority") or f.get("priority")
    try: pr = int(pr)
    except Exception: pr = 2
    if pr >= 3: sc += 25; sig.append("prio_haute")
    elif pr == 2: sc += 10
    arx = e.get("ASSET_CRITICAL_REGEX","")
    if arx and re.search(arx, entity, re.I): sc += 30; sig.append("actif_critique")
    if str(f.get("src_ip_threat_indicated")).lower()=="true" or \
       str(f.get("dest_ip_threat_indicated")).lower()=="true" or \
       f.get("alert_tag")=="threat_intel": sc += 20; sig.append("threat_intel")
    if str(f.get("off_hours")).lower() in ("oui","true","yes"): sc += 10; sig.append("hors_heures")
    kth = int(e.get("KILLCHAIN_COUNT","4"))
    if vel >= kth: sc += 25; sig.append(f"killchain(x{vel})")
    return min(sc, 100), sig   # borne unique : la barre HTML et "score/100" ne depassent plus 100
                               # (aucun seuil de decision n'est > 100, l'ordre est preserve). Audit 17/07.

def _redact(s):
    s = re.sub(r"\b\d{1,3}(?:\.\d{1,3}){3}\b", "x.x.x.x", str(s))
    s = re.sub(r"[\w.+-]+@[\w.-]+\.\w+", "user@masque", s)
    return s

# Contexte ENVOYE au juge externe : construit depuis une LISTE BLANCHE, pas depuis
# le ctx complet. L'ancien redact_ctx partait de dict(ctx) et ne caviardait QUE
# 'entite' et 'message' : src_ip, user, host, seal_badge et surtout backlog[].raw
# (le log brut integral) partaient EN CLAIR a l'API. Verrou pose avant toute
# activation de ANTHROPIC_API_KEY (aujourd'hui inerte : cle vide -> sortie amont).
_LLM_WHITELIST = ("titre", "tier", "score", "signaux", "velocite", "site", "net",
                  "country", "ti", "priority", "mitre_tech", "mitre_name",
                  "mitre_tac", "dest_port", "threat", "threat_type", "desc")

def redact_ctx(ctx):
    """Caviarde et RESTREINT le contexte avant envoi a l'API externe (gouvernance
    donnees). N'expose que la liste blanche ci-dessus (assez pour juger la
    pertinence) + un indice interne/externe de l'IP (sans la valeur) + un extrait
    de message deja caviarde. EXCLUS explicitement : backlog[].raw (log brut),
    seal_badge, user, host, src_ip/dest_ip. Passe finale : re-caviardage de toute
    IP/email residuelle sur le JSON complet."""
    c = {k: ctx.get(k) for k in _LLM_WHITELIST if ctx.get(k) not in (None, "", [], "-")}
    ent = ctx.get("entite", "")
    hint = ""
    m = re.search(r"\b\d{1,3}(?:\.\d{1,3}){3}\b", ent)
    if m: hint = " (interne)" if m.group(0).startswith(("10.", "172.", "192.168.")) else " (externe)"
    c["entite"] = _redact(ent) + hint
    c["extrait"] = _redact(ctx.get("message", ""))
    try:
        return json.loads(_redact(json.dumps(c, ensure_ascii=False)))
    except Exception:
        return c   # le round-trip ne doit jamais casser le juge : c est deja caviarde

def llm_relevant(e, ctx):
    key = e.get("ANTHROPIC_API_KEY","")
    if not key: return None, "llm_absent"
    if e.get("OMNI_TRIAGE_LLM_REDACT","true").lower() != "false": ctx = redact_ctx(ctx)
    model = e.get("OMNI_TRIAGE_LLM_MODEL","claude-haiku-4-5-20251001")
    prompt = ("Tu es analyste SOC. Au vu de cette alerte ET de son contexte (score de "
        "risque, actif, site, velocite), decide si elle merite un MAIL immediat a "
        "l'equipe securite (vrai positif actionnable et important) ou non (bruit, "
        "informatif, FP probable). Reponds STRICTEMENT en JSON "
        '{"mail": true|false, "raison":"<12 mots"}.\nContexte:\n' + json.dumps(ctx, ensure_ascii=False))
    body = json.dumps({"model":model,"max_tokens":150,
        "messages":[{"role":"user","content":prompt}]}).encode()
    try:
        req = urllib.request.Request("https://api.anthropic.com/v1/messages", data=body,
            headers={"x-api-key":key,"anthropic-version":"2023-06-01","content-type":"application/json"})
        r = json.load(urllib.request.urlopen(req, timeout=20))
        txt = "".join(b.get("text","") for b in r.get("content",[]))
        j = json.loads(re.search(r"\{.*\}", txt, re.S).group(0))
        return bool(j.get("mail")), "llm:"+str(j.get("raison",""))[:60]
    except Exception as ex:
        return None, f"llm_erreur:{type(ex).__name__}"

