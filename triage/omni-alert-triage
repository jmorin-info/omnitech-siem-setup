import unicodedata
def _noaccent(s):
    return "".join(c for c in unicodedata.normalize("NFD", str(s)) if unicodedata.category(c) != "Mn")
_LOG_NOISE_KEYS = {
    "rulename", "utctime", "processguid", "logonguid", "terminalsessionid",
    "sourceprocessguid", "targetprocessguid", "parentprocessguid",
    "fileversion", "product", "company", "description", "originalfilename",
    "hashes", "integritylevel", "tokenelevationtype", "version",
    "currentdirectory", "logonid",
    # WinSec FR : identifiants techniques peu parlants en mail
    "id de securite", "id d'ouverture de session", "id de l'ouverture de session",
    "guid d'ouverture de session",
}
_LOG_NULL_VALS = {"-", "0x0", "s-1-0-0", "{00000000-0000-0000-0000-000000000000}"}

# --- Logs FortiGate : une SEULE ligne de paires key=value (valeurs parfois
# entre guillemets). _format_log les rendait illisibles (partition sur le 1er ':'
# -> tout en une valeur geante tronquee). On les parse et on affiche les champs
# UTILES d'abord (qui/quoi/ou), en masquant le bruit technique. Constat Julien 06/07/2026.
_KV_RE = re.compile(r'([A-Za-z_][\w\-]*)=("(?:[^"\\]|\\.)*"|\S*)')
_FORTI_ORDER = ["devname", "type", "subtype", "level", "severity", "crlevel",
    "action", "utmaction", "status", "attack", "virus", "msg", "url", "hostname",
    "filename", "user", "srcip", "srccountry", "srcport", "srcintf", "dstip",
    "dstcountry", "dstport", "dstintf", "service", "proto", "app", "appcat",
    "direction", "catdesc", "cat", "ref", "count", "sig", "signal"]
_FORTI_NOISE = {"logver", "timestamp", "devid", "vd", "eventtime", "tz", "logid",
    "sessionid", "eventtype", "policyid", "policytype", "poluuid", "attackid",
    "crscore", "craction", "appid", "itime", "srcintfrole", "dstintfrole",
    "trandisp", "logdesc", "date", "time", "srcuuid", "dstuuid", "sentbyte",
    "rcvdbyte", "sentpkt", "rcvdpkt", "srcmac", "dstmac", "mastersrcmac",
    "masterdstmac", "duration", "transip", "transport", "tranport", "wanin",
