def guidance_key(tag, title):
    """Cle de playbook. L'identifiant de regle SEAL present dans le titre
    ("OMNI - SEAL ALM-003 - ...") PRIME sur alert_tag -> cle "seal_alm_003".
    Raison de l'inversion (audit 17/07/2026) : le tag SEAL est trop grossier pour
    departager les playbooks. seal_sla_breach est PARTAGE par SLA-001 et SLA-002
    dont les remediations different ; d'autres detections SEAL n'ont pas de tag du
    tout, ou un tag sans entree de guidance (seal_console_auth_failure, alors que
    le playbook seal_hyp_001 existe). Un tag ne peut donc pas servir de cle SEAL :
    l'identifiant du titre, lui, est unique et deterministe. Le repli sur le tag
    reste pour les detections NON-SEAL (leurs titres ne matchent pas _SEAL_ID_RE
    -> comportement strictement inchange pour elles)."""
    m = _SEAL_ID_RE.search(title or "")
    if m: return f"seal_{m.group(1).lower()}_{m.group(2)}"
    return tag or ""

def guidance(tag):
    """Playbook 4 parties (ce_que_cest/a_verifier/remediation/correction) par alert_tag."""
    if not tag: return None
    try:
        m = os.path.getmtime(GUIDANCE)
        if m != _GUIDE_CACHE["mtime"]:
            _GUIDE_CACHE["data"] = json.load(open(GUIDANCE)); _GUIDE_CACHE["mtime"] = m
    except Exception:
        return None
    return _GUIDE_CACHE["data"].get(tag)

