# /etc/omni-alert-triage.env (NE PAS COMMITER avec une vraie cle)
SMTP_HOST=smtp-internal.omnitech-security.fr
SMTP_PORT=25
SMTP_FROM=no-reply@omnitech-security.fr
SMTP_SUBJECT_PREFIX=[SIEM OMNITECH]
MAIL_RECIPIENTS=informatique@omnitech-security.fr
# Zone grise sans LLM : decide par score (voir seuils). 'mail' ignore (legacy).
OMNI_TRIAGE_GRAY_DEFAULT=mail
# --- Juge LLM distant de la zone grise (réglages neutres, lus ici) ---
# Clé du service (vide = juge distant inactif), URL de l'API, en-têtes supplémentaires
# au format « Nom: valeur;Nom2: valeur2 », modèle demandé. Aucune valeur par défaut dans le code.
OMNI_LLM_CLE=
OMNI_LLM_URL=
OMNI_LLM_ENTETE=
OMNI_TRIAGE_LLM_MODEL=
TRIAGE_DEDUP_SECONDS=3600
TRIAGE_FP_ENTITIES=src_ip=10.94.30.13
# --- v2 scoring ---
MAIL_SCORE_THRESHOLD=80
GRAY_SCORE_THRESHOLD=70
ASSET_CRITICAL_REGEX=(dc0|dc1|dc-|ad-|srv-ad|contro)
KILLCHAIN_COUNT=4
KILLCHAIN_WINDOW=1800
# Secret partage notif->service (genere par 38 si vide). En-tete X-Triage-Token.
TRIAGE_TOKEN=
# Caviarder IP/emails avant envoi LLM (gouvernance donnees). true par defaut.
OMNI_TRIAGE_LLM_REDACT=true
FP_DEFAULT_TTL_DAYS=30
OMNI_SOC_URL=https://bx-it-graylog-vm.omnitech.security/soc/
QUICK_SECRET=
# --- SIEM v5 (27/11/2026) ---
# Rodage : un titre commençant par OMNI_RODAGE_PREFIXE part au récapitulatif quotidien jusqu'au
# OMNI_RODAGE_JUSQUA inclus (AAAA-MM-JJ, 23:59 heure locale), sauf une CRITIQUE dont le titre
# correspond à l'expression régulière OMNI_RODAGE_IMMEDIAT. Retour : OMNI_RODAGE=0 ou date vide.
OMNI_RODAGE=1
OMNI_RODAGE_JUSQUA=2026-12-04
OMNI_RODAGE_PREFIXE=OMNI v5 -
OMNI_RODAGE_IMMEDIAT=dcsync
# KEV : priorité relevée d'un cran si la machine porte une vulnérabilité du catalogue KEV
# (0 = désactivé) ; alertes écartées concernées envoyées au récapitulatif ; expression régulière
# des titres exclus (vide = liste par défaut du code) ; durée du cache en secondes.
OMNI_V5_KEV=1
OMNI_V5_KEV_ECARTEES=1
OMNI_V5_KEV_EXCLURE=
OMNI_V5_KEV_CACHE=1800
# Juge de la zone grise : cloud (juge distant ci-dessus, défaut), local (station sur le réseau
# interne) ou off ; repli si le juge local ne répond pas : score (défaut) ou cloud.
OMNI_V5_JUGE=cloud
OMNI_V5_JUGE_REPLI=score
# Juge local : URL de base de la station (http://hote:port), modèle, délai (s), pause après échec (s),
# jetons de réponse, durée de maintien du modèle en mémoire.
OMNI_V5_JUGE_URL=
OMNI_V5_JUGE_MODELE=
OMNI_V5_JUGE_DELAI=20
OMNI_V5_JUGE_PAUSE=3600
OMNI_V5_JUGE_TOKENS=400
OMNI_V5_JUGE_KEEPALIVE=30m
# Récapitulatif : sections rodage et indicateurs (0 = retirées), fenêtre des indicateurs (jours),
# charte des mails (v3, ou v2 pour les anciens gabarits).
OMNI_V5_DIGEST=1
OMNI_V5_INDICATEURS_JOURS=7
OMNI_MAIL_CHARTE=v3
