# /etc/omni-alert-triage.env (NE PAS COMMITER avec une vraie cle)
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_FROM=
SMTP_SUBJECT_PREFIX=[SIEM OMNITECH]
MAIL_RECIPIENTS=
# Zone grise sans LLM : decide par score (voir seuils). 'mail' ignore (legacy).
OMNI_TRIAGE_GRAY_DEFAULT=mail
ANTHROPIC_API_KEY=
OMNI_TRIAGE_LLM_MODEL=claude-haiku-4-5-20251001
TRIAGE_DEDUP_SECONDS=3600
TRIAGE_FP_ENTITIES=
# --- v2 scoring ---
MAIL_SCORE_THRESHOLD=80
GRAY_SCORE_THRESHOLD=70
ASSET_CRITICAL_REGEX=(dc0|dc1|dc-|ad-|srv-ad|contro)
KILLCHAIN_COUNT=4
KILLCHAIN_WINDOW=1800
# Secret partage notif->service (genere par 38 si vide). En-tete X-Triage-Token.
TRIAGE_TOKEN=
# Caviarder IP/emails avant envoi LLM (gouvernance donnees). true par defaut.
OMNI_TRIAGE_LLM_REDACT=true
FP_DEFAULT_TTL_DAYS=30
OMNI_SOC_URL=
QUICK_SECRET=

# Adresse publique de Graylog ; sinon origine de OMNI_SOC_URL. Pas de secret dans les URL.
GRAYLOG_WEB_URL=
# Aucun juge distant ni relèvement KEV avant configuration/qualification du site.
OMNI_V5_JUGE=off
OMNI_V5_JUGE_URL=http://127.0.0.1:11434
OMNI_V5_KEV=0
# Exceptions facultatives, précises et propres au site. Aucun profil livré actif.
OMNI_FP_V4=0
OMNI_FP_V4_POLICY=/etc/omni-alert-triage-fp-v4.json
# Désactiver le rodage tant que ses dates/règles n'ont pas été choisies sur ce site.
OMNI_RODAGE=0
OMNI_RODAGE_JUSQUA=
OMNI_RODAGE_IMMEDIAT=
SEAL_QA_SITE=
