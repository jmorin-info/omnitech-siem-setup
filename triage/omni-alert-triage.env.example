# /etc/omni-alert-triage.env (NE PAS COMMITER avec une vraie cle)
SMTP_HOST=smtp-internal.omnitech-security.fr
SMTP_PORT=25
SMTP_FROM=no-reply@omnitech-security.fr
SMTP_SUBJECT_PREFIX=[SIEM OMNITECH]
MAIL_RECIPIENTS=informatique@omnitech-security.fr
# Zone grise sans LLM : decide par score (voir seuils). 'mail' ignore (legacy).
OMNI_TRIAGE_GRAY_DEFAULT=mail
ANTHROPIC_API_KEY=
OMNI_TRIAGE_LLM_MODEL=claude-haiku-4-5-20251001
TRIAGE_DEDUP_SECONDS=3600
TRIAGE_FP_ENTITIES=src_ip=10.94.30.13
# --- v2 scoring ---
MAIL_SCORE_THRESHOLD=80
GRAY_SCORE_THRESHOLD=70
ASSET_CRITICAL_REGEX=(dc0|dc1|dc-|ad-|srv-ad|contro)
KILLCHAIN_COUNT=4
KILLCHAIN_WINDOW=1800
# Secret partage notif->service (genere par 38 si vide). En-tete X-Triage-Token.
TRIAGE_TOKEN=
# Caviarder IP/emails avant envoi LLM (gouvernance donnees). true par defaut.
OMNI_TRIAGE_LLM_REDACT=true
FP_DEFAULT_TTL_DAYS=30
OMNI_SOC_URL=https://bx-it-graylog-vm.omnitech.security/soc/
QUICK_SECRET=
