{
  "id": "/soc/",
  "name": "OMNI SOC — Console de sécurité",
  "short_name": "OMNI SOC",
  "description": "Console SOC du SIEM OMNITECH : incidents, blocages SOAR, exploitation du SIEM.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "/soc/?source=pwa",
  "scope": "/soc/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070a11",
  "theme_color": "#070a11",
