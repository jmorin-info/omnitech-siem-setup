#!/usr/bin/env python3
# =============================================================================
# omni-soc-admin-exec - exécuteur privilégié des actions d'administration de la
#   console SOC. Le backend omni-mobile-api est confiné (il n'écrit que dans
#   /var/lib/omni-mobile) : il dépose ici des actions APPROUVÉES, que ce script
#   (root, oneshot, déclenché par omni-soc-admin-exec.path + timer de secours)
#   revalide intégralement avant d'agir. Il ne fait confiance à aucun champ :
#     - type d'action dans une liste fermée ;
#     - paramètres dans une liste blanche bornée (identique au backend) ;
#     - demande d'origine présente, approuvée, non expirée, approbateur distinct
#       du demandeur (sauf SOC_EXEC_SELF_APPROVE=1) ;
#     - redémarrages : liste blanche PROPRE à l'exécuteur (SOC_EXEC_RESTARTABLE,
#       vide par défaut = aucun redémarrage possible).
#   Écritures atomiques (fichier temporaire + fsync + rename, droits conservés),
#   sauvegarde horodatée avant chaque modification (10 conservées), résultat dans
#   exec/done/<id>.json et entrée dans le journal d'audit chaîné de la console.
#   Aucune commande shell : subprocess en liste d'arguments uniquement.
# Configuration facultative : /etc/default/omni-soc-admin-exec (ou OMNI_SOC_EXEC_CONFIG).
# =============================================================================
import fcntl
import glob
import hashlib
import ipaddress
import json
import os
import re
import shutil
import subprocess
import sys
import time

CONF = {}
for _k in ("SOC_ADMIN_DIR", "SOC_TRIAGE_ENV", "SOC_SOAR_ENV", "SOC_SOAR_FIX", "SOC_SYSTEMCTL",
           "SOC_EXEC_RESTARTABLE", "SOC_EXEC_SELF_APPROVE"):
    if os.environ.get(_k):
        CONF[_k] = os.environ[_k]
_cfg = os.environ.get("OMNI_SOC_EXEC_CONFIG", "/etc/default/omni-soc-admin-exec")
try:
    with open(_cfg) as fh:
        for line in fh:
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.strip().split("=", 1)
                CONF[k.strip()] = v.strip().strip('"').strip("'")
except OSError:
    pass

ADMIN_DIR = CONF.get("SOC_ADMIN_DIR", "/var/lib/omni-mobile/admin")
PEND = os.path.join(ADMIN_DIR, "exec", "pending")
DONE = os.path.join(ADMIN_DIR, "exec", "done")
REQS = os.path.join(ADMIN_DIR, "requests")
AUDIT = os.path.join(ADMIN_DIR, "audit.jsonl")
TRIAGE_ENV = CONF.get("SOC_TRIAGE_ENV", "/etc/omni-alert-triage.env")
SOAR_ENV = CONF.get("SOC_SOAR_ENV", "/etc/omni-soar/soar.env")
SOAR_FIX = CONF.get("SOC_SOAR_FIX", "/etc/omni-soar/exclusions-statiques.txt")
SYSTEMCTL = CONF.get("SOC_SYSTEMCTL", "systemctl")
RESTARTABLE = {u.strip() for u in CONF.get("SOC_EXEC_RESTARTABLE", "").split(",") if u.strip()}
SELF_APPROVE = CONF.get("SOC_EXEC_SELF_APPROVE", "0") == "1"
# Garde-fou des tests : en OMNI_TEST_MODE=1, refus de démarrer si un chemin écrit vise la production.
if os.environ.get("OMNI_TEST_MODE") == "1":
    _bad = [n for n, v in (("SOC_ADMIN_DIR", ADMIN_DIR), ("SOC_TRIAGE_ENV", TRIAGE_ENV), ("SOC_SOAR_ENV", SOAR_ENV),
                           ("SOC_SOAR_FIX", SOAR_FIX))
            if any(os.path.realpath(v) == p or os.path.realpath(v).startswith(p + "/")
                   for p in ("/var/lib", "/etc", "/var/www", "/var/log", "/usr", "/opt/oms-"))]
    _sc = os.path.realpath(shutil.which(SYSTEMCTL) or SYSTEMCTL)
    if _sc.startswith(("/usr/", "/bin/", "/sbin/")):
        _bad.append("SOC_SYSTEMCTL")
    if _bad:
        sys.exit("FATAL omni-soc-admin-exec (OMNI_TEST_MODE=1) : chemin de production refusé : " + ", ".join(_bad))
MAX_RESTARTS_PER_HOUR = 3
KEEP_BACKUPS = 10

# Listes blanches : DOIVENT rester identiques à TRIAGE_PARAMS / SOAR_PARAMS du backend.
_EMAIL_ONE = re.compile(r"^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,190}\.[A-Za-z]{2,24}$")
TRIAGE_PARAMS = {
    "MAIL_SCORE_THRESHOLD": {"type": "int", "min": 50, "max": 100},
    "GRAY_SCORE_THRESHOLD": {"type": "int", "min": 30, "max": 95},
    "TRIAGE_DEDUP_SECONDS": {"type": "int", "min": 300, "max": 86400},
    "FP_DEFAULT_TTL_DAYS": {"type": "int", "min": 1, "max": 90},
    "KILLCHAIN_COUNT": {"type": "int", "min": 2, "max": 10},
    "KILLCHAIN_WINDOW": {"type": "int", "min": 300, "max": 7200},
    "MAIL_RECIPIENTS": {"type": "emails", "max_items": 10},
}
SOAR_PARAMS = {
    "SOAR_MODE": {"type": "enum", "values": ["actif", "simulation"]},
    "SOAR_MIN_HITS": {"type": "int", "min": 1, "max": 100},
    "SOAR_MIN_HITS_PAYS_NORMAL": {"type": "int", "min": 1, "max": 200},
    "SOAR_TTL_HOURS": {"type": "int", "min": 1, "max": 168},
    "SOAR_MAX": {"type": "int", "min": 10, "max": 2000},
}
UNIT_RE = re.compile(r"^(omni|oms)-[A-Za-z0-9@._-]{1,80}\.service$")
ID_RE = re.compile(r"^[0-9]{8}-[0-9]{6}-[0-9a-f]{8}$")


class Refus(Exception):
    pass


def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def load_json(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def atomic_write_text(path, text, ref=None):
    """Remplace `path` atomiquement en conservant droits et propriétaire (ou ceux de `ref`)."""
    d = os.path.dirname(path) or "."
    tmp = os.path.join(d, "." + os.path.basename(path) + ".soc-admin.tmp")
    st = None
    try:
        st = os.stat(ref or path)
    except OSError:
        pass
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    if st:
        os.chmod(tmp, st.st_mode & 0o7777)
        try:
            os.chown(tmp, st.st_uid, st.st_gid)
        except PermissionError:
            pass
    else:
        os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def own(path):
    """Les fichiers créés dans le répertoire partagé appartiennent au compte du backend."""
    try:
        st = os.stat(ADMIN_DIR)
        os.chown(path, st.st_uid, st.st_gid)
    except OSError:
        pass


def backup(path):
    if not os.path.exists(path):
        return ""
    dst = f"{path}.bak-soc-{time.strftime('%Y%m%d-%H%M%S')}"
    shutil.copy2(path, dst)
    os.chmod(dst, 0o600)
    olds = sorted(glob.glob(path + ".bak-soc-*"))
    for old in olds[:-KEEP_BACKUPS]:
        try:
            os.remove(old)
        except OSError:
            pass
    return dst


def check_param(table, key, value):
    if key not in table:
        raise Refus("paramètre hors liste blanche")
    spec = table[key]
    v = str(value)
    if spec["type"] == "int":
        if not re.fullmatch(r"[0-9]{1,6}", v) or not spec["min"] <= int(v) <= spec["max"]:
            raise Refus("valeur hors bornes")
        return str(int(v))
    if spec["type"] == "enum":
        if v not in spec["values"]:
            raise Refus("valeur non autorisée")
        return v
    if spec["type"] == "emails":
        items = [x for x in v.split(",") if x]
        if not items or len(items) > spec["max_items"] or not all(_EMAIL_ONE.match(x) for x in items):
            raise Refus("liste d'adresses invalide")
        return ",".join(items)
    raise Refus("type inconnu")


def set_env_key(path, key, value):
    """Met KEY=value dans un fichier KEY=VALUE (première occurrence active), autres lignes intactes."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = []
    before, done, out = None, False, []
    for line in lines:
        m = re.match(r"\s*([A-Z_][A-Z0-9_]*)=(.*)", line)
        if m and m.group(1) == key:
            if not done:
                before = m.group(2).strip().strip("'").strip('"')
                out.append(f"{key}={value}")
                done = True
            else:
                out.append("# " + line + "  # remplacé par la console SOC")
            continue
        out.append(line)
    if not done:
        out.append(f"{key}={value}")
    bk = backup(path)
    atomic_write_text(path, "\n".join(out) + "\n")
    return before, bk


def check_net(value):
    v = str(value)
    if len(v) > 43:
        raise Refus("valeur trop longue")
    try:
        n = ipaddress.ip_network(v, strict=False)
    except ValueError:
        raise Refus("IP ou CIDR invalide")
    if n.version != 4 or not n.network_address.is_global or n.prefixlen < 16:
        raise Refus("réseau IPv4 public /16 minimum attendu")
    return str(n.network_address) if n.num_addresses == 1 else str(n)


def exclusion_add(value, motif, actor):
    try:
        with open(SOAR_FIX, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        text = ""
    for line in text.splitlines():
        if line.split("#", 1)[0].strip() == value:
            raise Refus("déjà présente")
    clean = " ".join(motif.replace("#", " ").split())[:120]
    if text and not text.endswith("\n"):
        text += "\n"
    text += f"{value}  # {clean} (ajout {time.strftime('%d/%m/%Y')} par soc:{actor})\n"
    bk = backup(SOAR_FIX)
    atomic_write_text(SOAR_FIX, text)
    return bk


def exclusion_remove(value):
    with open(SOAR_FIX, encoding="utf-8") as f:
        lines = f.read().splitlines()
    kept = [l for l in lines if l.split("#", 1)[0].strip() != value]
    if len(kept) == len(lines):
        raise Refus("absente de la liste fixe")
    bk = backup(SOAR_FIX)
    atomic_write_text(SOAR_FIX, "\n".join(kept) + "\n")
    return bk


def restarts_last_hour():
    lim, n = time.time() - 3600, 0
    for p in glob.glob(os.path.join(DONE, "*.json")):
        d = load_json(p, {}) or {}
        if d.get("kind") == "service_restart" and d.get("status") == "faite" and os.path.getmtime(p) > lim:
            n += 1
    return n


def audit(actor, action, target, result, rid, before=None, after=None, motif=""):
    os.makedirs(ADMIN_DIR, exist_ok=True)
    entry = {"ts": now_iso(), "actor": str(actor)[:64], "role": "executeur", "ip": "", "event": "execution_privilegiee",
             "action": action, "target": str(target)[:200], "motif": str(motif)[:300], "before": before,
             "after": after, "result": str(result)[:500], "request_id": rid}
    fd = os.open(AUDIT, os.O_RDWR | os.O_CREAT | os.O_APPEND, 0o640)
    with os.fdopen(fd, "rb+") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        try:
            fh.seek(0, 2)
            size = fh.tell()
            prev, seq = "0" * 64, 0
            if size:
                fh.seek(max(0, size - 65536))
                for line in reversed([l for l in fh.read().decode("utf-8", "replace").splitlines() if l.strip()]):
                    try:
                        e = json.loads(line)
                        prev, seq = str(e.get("hash", prev)), int(e.get("seq", 0))
                        break
                    except Exception:
                        continue
            entry["seq"] = seq + 1
            entry["prev"] = prev
            entry["hash"] = hashlib.sha256(json.dumps(entry, sort_keys=True, ensure_ascii=False).encode("utf-8")).hexdigest()
            fh.seek(0, 2)
            fh.write((json.dumps(entry, ensure_ascii=False) + "\n").encode("utf-8"))
            fh.flush()
            os.fsync(fh.fileno())
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
    own(AUDIT)


def handle(job):
    rid = str(job.get("id", ""))
    if not ID_RE.match(rid):
        raise Refus("identifiant invalide")
    if os.path.exists(os.path.join(DONE, rid + ".json")):
        raise Refus("action déjà traitée (rejeu refusé)")
    req = load_json(os.path.join(REQS, rid + ".json"))
    if not isinstance(req, dict):
        raise Refus("demande d'origine introuvable")
    if req.get("status") not in ("approuvee", "transmise"):
        raise Refus("demande non approuvée")
    if not req.get("decided_by"):
        raise Refus("approbateur absent")
    if str(req.get("decided_by", "")).lower() == str(req.get("requested_by", "")).lower() and not SELF_APPROVE:
        raise Refus("approbateur identique au demandeur")
    kind = job.get("kind")
    if kind != req.get("action"):
        raise Refus("action différente de la demande approuvée")
    p = job.get("params") or {}
    if p != (req.get("params") or {}):
        raise Refus("paramètres différents de la demande approuvée")
    actor = str(req.get("decided_by"))[:64]
    if kind in ("triage_param", "soar_param"):
        table, path = (TRIAGE_PARAMS, TRIAGE_ENV) if kind == "triage_param" else (SOAR_PARAMS, SOAR_ENV)
        key = str(p.get("key", ""))
        value = check_param(table, key, p.get("value", ""))
        before, bk = set_env_key(path, key, value)
        return {"before": before, "after": value, "resultat": f"{key} mis à jour (sauvegarde {os.path.basename(bk) or 'aucune'})"}
    if kind == "soar_exclusion_add":
        value = check_net(p.get("value"))
        bk = exclusion_add(value, str(req.get("motif", "")), actor)
        return {"before": "absente", "after": "exclusion fixe", "resultat": f"{value} ajoutée (sauvegarde {os.path.basename(bk) or 'aucune'})"}
    if kind == "soar_exclusion_remove":
        value = check_net(p.get("value"))
        bk = exclusion_remove(value)
        return {"before": "exclusion fixe", "after": "absente", "resultat": f"{value} retirée (sauvegarde {os.path.basename(bk)})"}
    if kind == "service_restart":
        unit = str(p.get("unit", ""))
        if not UNIT_RE.match(unit) or unit not in RESTARTABLE:
            raise Refus("service absent de la liste blanche de l'exécuteur (SOC_EXEC_RESTARTABLE)")
        if restarts_last_hour() >= MAX_RESTARTS_PER_HOUR:
            raise Refus("limite de redémarrages par heure atteinte")
        out = subprocess.run([SYSTEMCTL, "restart", "--", unit], capture_output=True, text=True, timeout=90)
        if out.returncode != 0:
            raise RuntimeError((out.stderr or out.stdout).strip()[-300:] or f"code {out.returncode}")
        return {"before": "", "after": "redémarré", "resultat": f"{unit} redémarré"}
    raise Refus("type d'action non autorisé")


def main():
    for d in (os.path.join(ADMIN_DIR, "exec"), PEND, DONE):
        os.makedirs(d, exist_ok=True)
        own(d)
    for path in sorted(glob.glob(os.path.join(PEND, "*.json")))[:20]:
        base = os.path.basename(path)
        job = load_json(path)
        res = {"id": base[:-5], "kind": "", "t_traitement": now_iso()}
        if not isinstance(job, dict):
            res.update(status="refusee", resultat="fichier illisible")
        else:
            res["kind"] = str(job.get("kind", ""))[:40]
            try:
                res.update(handle(job))
                res["status"] = "faite"
            except Refus as ex:
                res.update(status="refusee", resultat=str(ex))
            except Exception as ex:
                res.update(status="echec", resultat=f"{type(ex).__name__}: {str(ex)[:200]}")
        jd = job if isinstance(job, dict) else {}
        pr = jd.get("params") if isinstance(jd.get("params"), dict) else {}
        target = pr.get("key") or pr.get("value") or pr.get("unit") or ""
        try:
            audit(jd.get("actor", "?"), res.get("kind") or "inconnue", target,
                  f"{res['status']} : {res.get('resultat', '')}", res["id"], res.get("before"), res.get("after"),
                  jd.get("motif", ""))
        except Exception as ex:
            print(f"audit impossible : {ex}", file=sys.stderr)
        tmp = os.path.join(DONE, "." + base + ".tmp")
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(res, f, ensure_ascii=False)
        own(tmp)
        out_name = base
        if os.path.exists(os.path.join(DONE, base)):          # rejeu : ne pas écraser le résultat d'origine
            out_name = base[:-5] + ".rejeu-" + time.strftime("%Y%m%d%H%M%S") + ".json"
        os.replace(tmp, os.path.join(DONE, out_name))
        os.remove(path)
        print(f"{base}: {res['status']} {res.get('resultat', '')}")
    # rétention des résultats : 90 jours
    lim = time.time() - 90 * 86400
    for p in glob.glob(os.path.join(DONE, "*.json")):
        if os.path.getmtime(p) < lim:
            os.remove(p)
    hb = os.path.join(ADMIN_DIR, "exec", "executor-heartbeat")
    with open(hb, "w") as f:
        f.write(now_iso() + "\n")
    own(hb)


if __name__ == "__main__":
    main()
