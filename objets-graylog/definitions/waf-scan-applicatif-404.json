{
  "title": "OMNI - WAF : scan applicatif (>=25 erreurs 404 / IP / 10 min)",
  "description": "Une IP genere beaucoup de 404 sur BunkerWeb = énumération de chemins / scan applicatif (T1595).",
  "priority": 3,
  "alert": true,
  "flux_par_titre": [
    "OMNI - BunkerWeb"
  ],
  "notifications_par_titre": [
    "OMNI - Teams SOC"
  ],
  "config": {
    "type": "aggregation-v1",
    "query": "event_source:bunkerweb AND http_status:404",
    "query_parameters": [],
    "filters": [],
    "streams": [],
    "stream_categories": [],
    "group_by": [
      "src_ip"
    ],
    "series": [
      {
        "type": "count",
        "id": "count()",
        "field": null
      }
    ],
    "conditions": {
      "expression": {
        "expr": ">=",
        "left": {
          "expr": "number-ref",
          "ref": "count()"
        },
        "right": {
          "expr": "number",
          "value": 25.0
        }
      }
    },
    "search_within_ms": 600000,
    "execute_every_ms": 600000,
    "use_cron_scheduling": false,
    "cron_expression": null,
    "cron_timezone": null,
    "event_limit": 100
  },
  "field_spec": {
    "src_ip": {
      "data_type": "string",
      "providers": [
        {
          "type": "template-v1",
          "template": "${source.src_ip}",
          "require_values": false,
          "exclude_empty_fields": false
        }
      ]
    }
  },
  "key_spec": [
    "src_ip"
  ],
  "notification_settings": {
    "grace_period_ms": 600000,
    "backlog_size": 5
  },
  "storage": [
    {
      "type": "persist-to-streams-v1",
      "streams": [
        "000000000000000000000002"
      ]
    }
  ]
}
