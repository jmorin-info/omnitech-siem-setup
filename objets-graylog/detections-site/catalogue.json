     "description": "Sysmon 10 vers lsass.exe avec le droit VM_READ (0x10), processus source hors lecteurs_lsass (chemin|masque, faux positifs prouvés).",
     "temoins": {"winlogbeat_winlog_event_id": ["10"]},
     "condition": "to_string($message.event_source) == \"sysmon\" && to_string($message.winlogbeat_winlog_event_id) == \"10\" && ends_with(lowercase(to_string($ed.TargetImage)), \"\\\\lsass.exe\") && regex(\"^0x[0-9a-fA-F]*[13579bdfBDF][0-9a-fA-F]$\", to_string($ed.GrantedAccess)).matches == true && !{{dans:concat(concat(lowercase(to_string($ed.SourceImage)), \"|\"), lowercase(to_string($ed.GrantedAccess))):lecteurs_lsass}}",
     "entite": "lowercase(to_string($message.source))",
