{
  "schema_version": 1,
  "_lisez_moi": "Catalogue des détections portables, déployées par tools/omni-site-detections.py selon la configuration du site (/etc/omni-siem/detections.json, modèle site.exemple.json). Une détection n'est créée que si sa source est déclarée par le site ; elle n'est planifiée que si sa source produit ses champs, si ses événements témoins ont été reçus, si ses paramètres de site sont renseignés et si le rejeu reste sous le plafond de déclenchements. Les règles utilisent $ed.X pour $message.winlogbeat_winlog_event_data_X et les gabarits {{dans:EXPR:param}}, {{interne:EXPR}}, {{lucene:param}}.",
  "prefixe_titre": "OMNI v5 - ",
  "plafond_par_jour": 5,
  "sources": {
    "windows_security": {"libelle": "Windows Security (Winlogbeat)", "event_source": "windows_security", "index": "omni-winsec_*",
      "champs": ["event_source", "event_id", "source", "user", "src_ip", "alert_tag", "winlogbeat_winlog_event_id", "winlogbeat_winlog_channel", "winlogbeat_winlog_event_data_*"]},
    "windows_autres": {"libelle": "Windows autres journaux (System, PowerShell, Defender)", "event_source": "windows", "index": "omni-winother_*",
      "champs": ["event_source", "event_id", "source", "user", "alert_tag", "winlogbeat_winlog_event_id", "winlogbeat_winlog_channel", "winlogbeat_winlog_event_data_*"]},
    "sysmon": {"libelle": "Sysmon", "event_source": "sysmon", "index": "omni-sysmon_*",
      "champs": ["event_source", "event_id", "source", "user", "alert_tag", "winlogbeat_winlog_event_id", "winlogbeat_winlog_channel", "winlogbeat_winlog_event_data_*"]},
    "watchguard": {"libelle": "WatchGuard Firebox (module watchguard)", "event_source": "watchguard", "index": "graylog_*",
      "champs": ["event_source", "event_id", "event_category", "event_reason", "event_message", "source", "user", "src_ip", "dest_ip", "src_port", "dest_port", "src_zone", "dest_zone", "src_country", "dest_country", "action", "vpn_peer_ip", "vpn_gateway", "url_domain", "network_rule", "message", "msg_id"]},
    "m365": {"libelle": "Microsoft 365 (audit et connexions)", "event_source": "m365", "index": "omni-m365_*",
      "champs": ["event_source", "user", "src_ip", "alert_tag", "m365_*"]}
  },
  "champs_produits": {
    "v5_tag": "étiquette de la détection v5 (une valeur par détection)",
    "v5_severite": "CRITIQUE, ELEVE ou INFO",
    "v5_mitre": "technique MITRE ATT&CK",
    "v5_entite": "entité regroupée par la définition (compte, hôte ou adresse)",
    "v5_detail": "phrase lisible décrivant l'événement détecté",
    "ti_tag": "omni_v5_ti sur tout message enrichi par la threat intel",
    "ti_match": "indicateur trouvé (adresse IP ou domaine)",
    "ti_source": "flux qui liste l'indicateur : feodo, tor, threatfox, urlhaus",
    "ti_type": "type d'indicateur : c2_botnet, tor_sortie, ip_port, domaine…",
    "ti_malware": "famille de maliciel ou libellé du flux",
    "ti_confiance": "haute, moyenne, faible ou info",
    "ti_direction": "sortant (poste interne vers l'indicateur) ou entrant (indicateur vers le site)",
    "ti_contexte": "trafic, vpn ou web",
    "ti_port_match": "true si le port de destination est celui publié pour l'indicateur",
    "ti_ioc_ports": "ports publiés pour l'indicateur (;443;8080;)",
    "ti_ioc_date": "date de première publication de l'indicateur",
    "ti_ref": "référence dans le flux (identifiant, statut)"
  },
  "chaine_interne": {
    "_pourquoi": "Le tri trace chaque décision (dont le rodage) et les robots (ti_fetch…) écrivent en GELF sur 127.0.0.1:12201 ; le récapitulatif relit les décisions dans omni-interne*. Sans cette chaîne, une alerte en rodage serait invisible. Objets réutilisés s'ils existent (même port, même préfixe, même titre).",
    "entree": {"titre": "OMNI - GELF interne (127.0.0.1:12201)", "bind": "127.0.0.1", "port": 12201},
    "index_set": {"titre": "OMNI - Interne SIEM", "prefixe": "omni-interne", "retention_jours": 90},
    "stream": {"titre": "OMNI - Interne SIEM", "exclure_event_source": "^m365"}
  },
  "lookups": [
    {"nom": "omni-canary", "adaptateur": "omni-canary-adapter", "cache": "omni-canary-cache", "csv": "/etc/graylog/lookup/canary-accounts.csv",
     "cle": "account", "valeur": "note", "entete": "account,note", "toujours": true,
     "_pourquoi": "lue par la règle omni-winsec-10-canary du socle : sans table, Graylog écrit un avertissement par message"},
    {"nom": "omni-v5-ti-ip", "adaptateur": "omni-v5-ti-ip-adapter", "cache": "omni-v5-ti-ip-cache", "csv": "/etc/graylog/lookup/ti/ip.csv",
     "cle": "cle", "valeur": "valeur", "entete": "cle,valeur", "ti": true},
    {"nom": "omni-v5-ti-domaine", "adaptateur": "omni-v5-ti-domaine-adapter", "cache": "omni-v5-ti-domaine-cache", "csv": "/etc/graylog/lookup/ti/domaine.csv",
     "cle": "cle", "valeur": "valeur", "entete": "cle,valeur", "ti": true}
  ],
  "ti_regles": [
    {"id": "ti-wg-ip-dest", "source": "watchguard", "lookup": "omni-v5-ti-ip",
     "condition": "to_string($message.event_source) == \"watchguard\" && has_field(\"dest_ip\") && !{{interne:$message.dest_ip}} && !is_null(lookup_value(\"omni-v5-ti-ip\", to_string($message.dest_ip)))",
     "cle": "to_string($message.dest_ip)", "direction": "sortant", "contexte": "trafic", "port": "$message.dest_port"},
    {"id": "ti-wg-ip-src", "source": "watchguard", "lookup": "omni-v5-ti-ip",
     "condition": "to_string($message.event_source) == \"watchguard\" && has_field(\"src_ip\") && !{{interne:$message.src_ip}} && !is_null(lookup_value(\"omni-v5-ti-ip\", to_string($message.src_ip)))",
     "cle": "to_string($message.src_ip)", "direction": "entrant", "contexte": "trafic"},
    {"id": "ti-wg-vpn-pair", "source": "watchguard", "lookup": "omni-v5-ti-ip",
     "condition": "to_string($message.event_source) == \"watchguard\" && has_field(\"vpn_peer_ip\") && !{{interne:$message.vpn_peer_ip}} && !is_null(lookup_value(\"omni-v5-ti-ip\", to_string($message.vpn_peer_ip)))",
     "cle": "to_string($message.vpn_peer_ip)", "direction": "entrant", "contexte": "vpn"},
    {"id": "ti-wg-domaine", "source": "watchguard", "lookup": "omni-v5-ti-domaine",
     "condition": "to_string($message.event_source) == \"watchguard\" && has_field(\"url_domain\") && !is_null(lookup_value(\"omni-v5-ti-domaine\", lowercase(to_string($message.url_domain))))",
     "cle": "lowercase(to_string($message.url_domain))", "direction": "sortant", "contexte": "web"}
  ],
  "detections": [
    {"id": "win-dcsync", "source": "windows_security", "gravite": "CRITIQUE", "mitre": "T1003.006",
     "titre": "OMNI v5 - Windows DCSync par un compte hors liste de réplication",
     "description": "Réplication de l'annuaire (DS-Replication-Get-Changes[-All|-In-Filtered-Set]) demandée par un compte qui n'est pas dans comptes_replication (contrôleurs de domaine, Entra Connect).",
     "temoins": {"winlogbeat_winlog_event_id": ["4662"]}, "parametres": ["comptes_replication"],
     "condition": "to_string($message.event_source) == \"windows_security\" && to_string($message.winlogbeat_winlog_event_id) == \"4662\" && (contains(lowercase(to_string($ed.Properties)), \"1131f6aa-9c07-11d1-f79f-00c04fc2dcd2\") || contains(lowercase(to_string($ed.Properties)), \"1131f6ad-9c07-11d1-f79f-00c04fc2dcd2\") || contains(lowercase(to_string($ed.Properties)), \"89e95b76-444d-4c62-991a-0facbeda640c\")) && !{{dans:lowercase(to_string($ed.SubjectUserName)):comptes_replication}}",
     "entite": "lowercase(to_string($ed.SubjectUserName))",
     "detail": "concat(\"Réplication d'annuaire demandée par \", to_string($ed.SubjectUserName))",
     "fenetre_min": 5, "pas_min": 5, "grace_min": 30,
     "rejeu": {"prefiltre": "winlogbeat_winlog_event_id:4662 AND winlogbeat_winlog_event_data_Properties:(*1131f6aa* OR *1131f6ad* OR *89e95b76\\-444d*)",
               "echantillon": ["winlogbeat_winlog_event_data_SubjectUserName", "winlogbeat_winlog_event_data_Properties"]},
     "exemples": {"positif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "4662", "winlogbeat_winlog_event_data_Properties": "%%7688 {1131f6aa-9c07-11d1-f79f-00c04fc2dcd2}", "winlogbeat_winlog_event_data_SubjectUserName": "utilisateur-test"},
                  "negatif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "4662", "winlogbeat_winlog_event_data_Properties": "%%7688 {1131f6aa-9c07-11d1-f79f-00c04fc2dcd2}", "winlogbeat_winlog_event_data_SubjectUserName": "{{premier:comptes_replication}}"}}},
    {"id": "win-kerberoast", "source": "windows_security", "gravite": "ELEVE", "mitre": "T1558.003",
     "titre": "OMNI v5 - Windows Kerberoasting (ticket de service vers un compte utilisateur)",
     "description": "Ticket de service Kerberos accordé pour un compte utilisateur à SPN (ni compte machine, ni krbtgt, ni ticket vers soi-même), quel que soit le chiffrement, ou règle Kerberoasting RC4 du socle.",
     "temoins": {"winlogbeat_winlog_event_id": ["4769"]},
     "condition": "to_string($message.event_source) == \"windows_security\" && to_string($message.winlogbeat_winlog_event_id) == \"4769\" && to_string($ed.Status) == \"0x0\" && !ends_with(regex_replace(\"@.*$\", lowercase(to_string($ed.ServiceName)), \"\"), \"$\") && regex_replace(\"@.*$\", lowercase(to_string($ed.ServiceName)), \"\") != \"krbtgt\" && regex_replace(\"@.*$\", lowercase(to_string($ed.ServiceName)), \"\") != regex_replace(\"@.*$\", lowercase(to_string($ed.TargetUserName)), \"\")",
     "entite": "regex_replace(\"@.*$\", lowercase(to_string($ed.TargetUserName)), \"\")",
     "detail": "concat(concat(concat(\"Ticket de service pour \", to_string($ed.ServiceName)), \" demandé par \"), to_string($ed.TargetUserName))",
     "requete_supplementaire": "alert_tag:kerberoasting",
     "fenetre_min": 10, "pas_min": 5, "grace_min": 60,
     "rejeu": {"prefiltre": "winlogbeat_winlog_event_id:4769 AND winlogbeat_winlog_event_data_Status:0x0", "echantillon": ["winlogbeat_winlog_event_data_ServiceName", "winlogbeat_winlog_event_data_TargetUserName"]},
     "exemples": {"positif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "4769", "winlogbeat_winlog_event_data_Status": "0x0", "winlogbeat_winlog_event_data_ServiceName": "svc-sql", "winlogbeat_winlog_event_data_TargetUserName": "utilisateur@EXEMPLE.FR"},
                  "negatif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "4769", "winlogbeat_winlog_event_data_Status": "0x0", "winlogbeat_winlog_event_data_ServiceName": "SRV01$", "winlogbeat_winlog_event_data_TargetUserName": "utilisateur@EXEMPLE.FR"}}},
    {"id": "win-groupe-privilegie", "source": "windows_security", "gravite": "ELEVE", "mitre": "T1098",
     "titre": "OMNI v5 - Windows Ajout à un groupe privilégié (Admins du domaine, Administrateurs…)",
     "description": "Membre ajouté à un groupe dont le SID est privilégié (512, 518, 519, 520, S-1-5-32-544/548/549/551). Témoin : 4799 (même sous-catégorie d'audit).",
     "temoins": {"winlogbeat_winlog_event_id": ["4799", "4728", "4732", "4756"]},
     "condition": "to_string($message.event_source) == \"windows_security\" && (to_string($message.winlogbeat_winlog_event_id) == \"4728\" || to_string($message.winlogbeat_winlog_event_id) == \"4732\" || to_string($message.winlogbeat_winlog_event_id) == \"4756\") && (regex(\"-(512|518|519|520)$\", to_string($ed.TargetSid)).matches == true || regex(\"^S-1-5-32-(544|548|549|551)$\", to_string($ed.TargetSid)).matches == true)",
     "entite": "lowercase(to_string($ed.SubjectUserName))",
     "detail": "concat(concat(concat(\"Ajout de \", to_string($ed.MemberName)), \" au groupe \"), to_string($ed.TargetUserName))",
     "fenetre_min": 10, "pas_min": 5, "grace_min": 60,
     "rejeu": {"prefiltre": "winlogbeat_winlog_event_id:(4728 OR 4732 OR 4756)"},
     "exemples": {"positif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "4728", "winlogbeat_winlog_event_data_TargetSid": "S-1-5-21-1-2-3-512", "winlogbeat_winlog_event_data_SubjectUserName": "admin-test"},
                  "negatif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "4728", "winlogbeat_winlog_event_data_TargetSid": "S-1-5-21-1-2-3-1105", "winlogbeat_winlog_event_data_SubjectUserName": "admin-test"}}},
    {"id": "win-service-tier0", "source": "windows_security", "gravite": "ELEVE", "mitre": "T1543.003",
     "titre": "OMNI v5 - Windows Service installé sur un contrôleur de domaine ou un serveur Tier 0",
     "description": "4697 sur un hôte de hotes_tier0, hors instances de services par utilisateur (Nom_xxxxxxxx, svchost) et hors chemins de exclusions_services (faux positifs prouvés au rejeu).",
     "temoins": {"winlogbeat_winlog_event_id": ["4697"]}, "parametres": ["hotes_tier0"],
     "condition": "to_string($message.event_source) == \"windows_security\" && to_string($message.winlogbeat_winlog_event_id) == \"4697\" && {{dans:lowercase(to_string($message.source)):hotes_tier0}} && !(regex(\"_[0-9a-f]{5,8}$\", to_string($ed.ServiceName)).matches == true && contains(lowercase(to_string($ed.ServiceFileName)), \"\\\\system32\\\\svchost.exe\")) && !{{contient:lowercase(to_string($ed.ServiceFileName)):exclusions_services}}",
     "entite": "lowercase(to_string($message.source))",
     "detail": "concat(concat(concat(\"Service \", to_string($ed.ServiceName)), \" : \"), to_string($ed.ServiceFileName))",
     "fenetre_min": 10, "pas_min": 5, "grace_min": 60,
     "rejeu": {"prefiltre": "winlogbeat_winlog_event_id:4697"},
     "exemples": {"positif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "4697", "source": "{{premier:hotes_tier0}}", "winlogbeat_winlog_event_data_ServiceName": "pwnsvc", "winlogbeat_winlog_event_data_ServiceFileName": "C:\\Users\\Public\\x.exe"},
                  "negatif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "4697", "source": "{{premier:hotes_tier0}}", "winlogbeat_winlog_event_data_ServiceName": "CDPUserSvc_1a2b3c4d", "winlogbeat_winlog_event_data_ServiceFileName": "C:\\Windows\\system32\\svchost.exe -k UnistackSvcGroup"}}},
    {"id": "win-service-tier0-system", "source": "windows_autres", "gravite": "ELEVE", "mitre": "T1543.003",
     "titre": "OMNI v5 - Windows Service installé sur un Tier 0 (journal System 7045)",
     "description": "7045 sur un hôte de hotes_tier0, mêmes exclusions que la détection 4697 (le journal System ne dépend pas de l'audit de sécurité).",
     "temoins": {"winlogbeat_winlog_event_id": ["7045"]}, "parametres": ["hotes_tier0"],
     "condition": "to_string($message.event_source) == \"windows\" && to_string($message.winlogbeat_winlog_event_id) == \"7045\" && {{dans:lowercase(to_string($message.source)):hotes_tier0}} && !{{contient:lowercase(to_string($ed.ImagePath)):exclusions_services}}",
     "entite": "lowercase(to_string($message.source))",
     "detail": "concat(concat(concat(\"Service \", to_string($ed.ServiceName)), \" : \"), to_string($ed.ImagePath))",
     "fenetre_min": 10, "pas_min": 5, "grace_min": 60,
     "rejeu": {"prefiltre": "winlogbeat_winlog_event_id:7045"},
     "exemples": {"positif": {"event_source": "windows", "winlogbeat_winlog_event_id": "7045", "source": "{{premier:hotes_tier0}}", "winlogbeat_winlog_event_data_ServiceName": "pwnsvc", "winlogbeat_winlog_event_data_ImagePath": "C:\\Users\\Public\\x.exe"},
                  "negatif": {"event_source": "windows", "winlogbeat_winlog_event_id": "7045", "source": "poste-hors-tier0", "winlogbeat_winlog_event_data_ServiceName": "pwnsvc", "winlogbeat_winlog_event_data_ImagePath": "C:\\Users\\Public\\x.exe"}}},
    {"id": "win-tache-tier0", "source": "windows_security", "gravite": "ELEVE", "mitre": "T1053.005",
     "titre": "OMNI v5 - Windows Tâche planifiée créée sur un serveur Tier 0",
     "description": "4698 sur un hôte de hotes_tier0, hors tâches de exclusions_taches (faux positifs prouvés au rejeu).",
     "temoins": {"winlogbeat_winlog_event_id": ["4698", "4702"]}, "parametres": ["hotes_tier0"],
     "condition": "to_string($message.event_source) == \"windows_security\" && to_string($message.winlogbeat_winlog_event_id) == \"4698\" && {{dans:lowercase(to_string($message.source)):hotes_tier0}} && !{{dans:lowercase(to_string($ed.TaskName)):exclusions_taches}}",
     "entite": "lowercase(to_string($message.source))",
     "detail": "concat(concat(concat(\"Tâche \", to_string($ed.TaskName)), \" créée par \"), to_string($ed.SubjectUserName))",
     "fenetre_min": 10, "pas_min": 5, "grace_min": 60,
     "rejeu": {"prefiltre": "winlogbeat_winlog_event_id:4698"},
     "exemples": {"positif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "4698", "source": "{{premier:hotes_tier0}}", "winlogbeat_winlog_event_data_TaskName": "\\Malveillant"},
                  "negatif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "4698", "source": "poste-hors-tier0", "winlogbeat_winlog_event_data_TaskName": "\\Malveillant"}}},
    {"id": "win-shadow-credentials", "source": "windows_security", "gravite": "CRITIQUE", "mitre": "T1556",
     "titre": "OMNI v5 - Windows Shadow Credentials (msDS-KeyCredentialLink modifié)",
     "description": "5136 sur msDS-KeyCredentialLink par un compte qui n'est ni SYSTEM ni dans comptes_replication (Entra Connect gère les clés Windows Hello).",
     "temoins": {"winlogbeat_winlog_event_id": ["5136"]},
     "condition": "to_string($message.event_source) == \"windows_security\" && to_string($message.winlogbeat_winlog_event_id) == \"5136\" && lowercase(to_string($ed.AttributeLDAPDisplayName)) == \"msds-keycredentiallink\" && !{{dans:lowercase(to_string($ed.SubjectUserName)):comptes_replication}}",
     "entite": "lowercase(to_string($ed.SubjectUserName))",
     "detail": "concat(concat(concat(\"msDS-KeyCredentialLink modifié sur \", to_string($ed.ObjectDN)), \" par \"), to_string($ed.SubjectUserName))",
     "fenetre_min": 5, "pas_min": 5, "grace_min": 30,
     "rejeu": {"prefiltre": "winlogbeat_winlog_event_id:5136 AND winlogbeat_winlog_event_data_AttributeLDAPDisplayName:msDS\\-KeyCredentialLink"},
     "exemples": {"positif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "5136", "winlogbeat_winlog_event_data_AttributeLDAPDisplayName": "msDS-KeyCredentialLink", "winlogbeat_winlog_event_data_SubjectUserName": "attaquant", "winlogbeat_winlog_event_data_ObjectDN": "CN=x"},
                  "negatif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "5136", "winlogbeat_winlog_event_data_AttributeLDAPDisplayName": "description", "winlogbeat_winlog_event_data_SubjectUserName": "attaquant", "winlogbeat_winlog_event_data_ObjectDN": "CN=x"}}},
    {"id": "win-gpo-lien-sensible", "source": "windows_security", "gravite": "ELEVE", "mitre": "T1484.001",
     "titre": "OMNI v5 - Windows Lien de GPO modifié sur la racine du domaine ou l'OU Domain Controllers",
     "description": "5136 sur gPLink de la racine du domaine ou de OU=Domain Controllers.",
     "temoins": {"winlogbeat_winlog_event_id": ["5136"]},
     "condition": "to_string($message.event_source) == \"windows_security\" && to_string($message.winlogbeat_winlog_event_id) == \"5136\" && lowercase(to_string($ed.AttributeLDAPDisplayName)) == \"gplink\" && (starts_with(lowercase(to_string($ed.ObjectDN)), \"dc=\") || contains(lowercase(to_string($ed.ObjectDN)), \"ou=domain controllers,\"))",
     "entite": "lowercase(to_string($ed.SubjectUserName))",
     "detail": "concat(concat(concat(\"gPLink modifié sur \", to_string($ed.ObjectDN)), \" par \"), to_string($ed.SubjectUserName))",
     "fenetre_min": 10, "pas_min": 5, "grace_min": 60,
     "rejeu": {"prefiltre": "winlogbeat_winlog_event_id:5136 AND winlogbeat_winlog_event_data_AttributeLDAPDisplayName:gPLink"},
     "exemples": {"positif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "5136", "winlogbeat_winlog_event_data_AttributeLDAPDisplayName": "gPLink", "winlogbeat_winlog_event_data_ObjectDN": "DC=exemple,DC=fr", "winlogbeat_winlog_event_data_SubjectUserName": "admin-test"},
                  "negatif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "5136", "winlogbeat_winlog_event_data_AttributeLDAPDisplayName": "gPLink", "winlogbeat_winlog_event_data_ObjectDN": "OU=Postes,DC=exemple,DC=fr", "winlogbeat_winlog_event_data_SubjectUserName": "admin-test"}}},
    {"id": "win-asrep-preparation", "source": "windows_security", "gravite": "ELEVE", "mitre": "T1558.004",
     "titre": "OMNI v5 - Windows Pré-authentification Kerberos retirée d'un compte (préparation AS-REP roasting)",
     "description": "4738 dont UserAccountControl contient %%2096 (Don't Require Preauth activé). Témoin : 4738 (audit de la gestion des comptes utilisateurs).",
     "temoins": {"winlogbeat_winlog_event_id": ["4738"]},
     "condition": "to_string($message.event_source) == \"windows_security\" && to_string($message.winlogbeat_winlog_event_id) == \"4738\" && contains(to_string($ed.UserAccountControl), \"%%2096\")",
     "entite": "lowercase(to_string($ed.TargetUserName))",
     "detail": "concat(concat(concat(\"Pré-authentification retirée sur \", to_string($ed.TargetUserName)), \" par \"), to_string($ed.SubjectUserName))",
     "fenetre_min": 10, "pas_min": 5, "grace_min": 60,
     "rejeu": {"prefiltre": "winlogbeat_winlog_event_id:4738"},
     "exemples": {"positif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "4738", "winlogbeat_winlog_event_data_UserAccountControl": "%%2096", "winlogbeat_winlog_event_data_TargetUserName": "cible"},
                  "negatif": {"event_source": "windows_security", "winlogbeat_winlog_event_id": "4738", "winlogbeat_winlog_event_data_UserAccountControl": "-", "winlogbeat_winlog_event_data_TargetUserName": "cible"}}},
    {"id": "win-pulverisation", "source": "windows_security", "gravite": "ELEVE", "mitre": "T1110.003",
