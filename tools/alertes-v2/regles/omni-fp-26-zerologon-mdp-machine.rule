rule "omni-fp-26-zerologon-mdp-machine"
// "Zerologon suspecte (4742 par ANONYMOUS LOGON)" : 142 evenements / 30 j, TOUS sur des comptes ordinateur ou gMSA
// membres, LogonId 0x3e6, avec PasswordLastSet renseigne = changement de mot de passe machine normal via Netlogon
// (NetrServerPasswordSet2 journalise le sujet ANONYMOUS LOGON). Zerologon vise le compte d'un CONTROLEUR DE DOMAINE :
// tout compte qui ressemble a un DC (motif "-AD-" / "-ADnn") continue d'alerter, ainsi que tout compte non machine.
when
  to_string($message.alert_tag) == "zerologon_suspect"
  AND ends_with(to_string($message.winlogbeat_winlog_event_data_TargetUserName), "$")
  AND regex("(?i)(^|-)AD(-|[0-9])", to_string($message.winlogbeat_winlog_event_data_TargetUserName)).matches == false
  AND to_string($message.winlogbeat_winlog_event_data_SubjectLogonId) == "0x3e6"
  AND to_string($message.winlogbeat_winlog_event_data_PasswordLastSet) != "-"
  AND to_string($message.winlogbeat_winlog_event_data_PasswordLastSet) != ""
then
  set_field("fp_allowlist", true);
  set_field("fp_signature", "zerologon_mdp_machine");
  set_field("fp_allowlist_reason", "zerologon_suspect: rotation normale du mot de passe d'un poste/gMSA membre (pas un DC) - v2 11/11/2026");
  remove_single_field("alert_tag");
end
