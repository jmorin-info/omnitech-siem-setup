        "id": "count()",
        "field": null
      }
    ],
    "conditions": {
      "expression": {
        "expr": ">=",
        "left": {
          "expr": "number-ref",
          "ref": "count()"
        },
        "right": {
          "expr": "number",
          "value": 1.0
        }
      }
    },
    "search_within_ms": 600000,
    "execute_every_ms": 300000
