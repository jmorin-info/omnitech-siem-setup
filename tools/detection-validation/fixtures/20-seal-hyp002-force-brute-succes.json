{
  "titre": "OMNI - SEAL HYP-002 - Brute force suivie d'un succès (même compte)",
  "critique": true,
  "mitre": "T1110",
  "justification": "Compte console SEAL qui réussit à se connecter après une série d'échecs : mot de passe deviné sur l'hyperviseur de contrôle d'accès physique. Jusqu'en 11/2026 la définition attendait une étiquette qu'aucun producteur ne posait.",
  "capture": "2026-11-22, GET /api/events/definitions (production) + cible de tools/maj-detections-2026-11/cibles.json",
  "definition": {
    "query": "event_domain:hypervisor_audit AND event_action:(ConnectionFailure OR Connection)",
    "streams": [
      "OMNI - SEAL Audit"
    ],
    "group_by": [
      "actor_login",
      "seal_site"
    ],
    "series": [
      {
        "id": "sum(severity_num)",
        "type": "sum",
        "field": "severity_num"
      },
      {
        "id": "min(severity_num)",
        "type": "min",
        "field": "severity_num"
      }
    ],
    "conditions": {
      "expression": {
        "expr": "&&",
        "left": {
          "expr": ">=",
          "left": {
            "expr": "number-ref",
            "ref": "sum(severity_num)"
          },
          "right": {
            "expr": "number",
            "value": 25.0
          }
        },
        "right": {
          "expr": "<=",
          "left": {
            "expr": "number-ref",
            "ref": "min(severity_num)"
          },
          "right": {
            "expr": "number",
            "value": 0.0
          }
        }
      }
    },
    "search_within_ms": 900000,
    "execute_every_ms": 900000
  },
  "cas": [
