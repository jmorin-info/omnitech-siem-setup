{
  "titre": "OMNI - Password spraying (>=8 comptes / IP / 10 min)",
  "critique": true,
  "mitre": "T1110.003",
  "justification": "Pulvérisation de mots de passe : cardinalité des comptes par IP source.",
  "capture": "2026-11-22, GET /api/events/definitions (production)",
  "definition": {
    "query": "event_id:4625 AND _exists_:src_ip AND NOT user:*$",
    "streams": [
      "OMNI - Windows Security"
    ],
    "group_by": [
      "src_ip"
    ],
    "series": [
      {
        "type": "card",
        "id": "card(user)",
        "field": "user"
      }
    ],
    "conditions": {
      "expression": {
        "expr": ">=",
        "left": {
          "expr": "number-ref",
          "ref": "card(user)"
        },
        "right": {
          "expr": "number",
          "value": 8.0
        }
      }
    },
    "search_within_ms": 600000,
    "execute_every_ms": 600000
  },
  "cas": [
    {
      "nom": "8 comptes depuis la même IP",
      "attendu": {
        "evenements": 1,
        "cles": [
          [
            "10.33.10.50"
          ]
        ]
      },
      "documents": [
        {
          "flux": "OMNI - Windows Security",
          "age_s": 60,
          "champs": {
            "event_id": "4625",
            "src_ip": "10.33.10.50",
            "user": "user{i}"
          },
          "repeter": 8,
          "pas_s": 30
        }
      ]
    },
    {
      "nom": "7 comptes : sous le seuil",
      "attendu": {
        "evenements": 0
      },
      "documents": [
        {
          "flux": "OMNI - Windows Security",
          "age_s": 60,
          "champs": {
            "event_id": "4625",
            "src_ip": "10.33.10.50",
            "user": "user{i}"
          },
          "repeter": 7,
          "pas_s": 30
        }
      ]
    },
    {
      "nom": "8 échecs du même compte",
      "attendu": {
        "evenements": 0
      },
      "documents": [
        {
          "flux": "OMNI - Windows Security",
          "age_s": 60,
          "champs": {
            "event_id": "4625",
            "src_ip": "10.33.10.50",
            "user": "jdupont"
          },
          "repeter": 8,
          "pas_s": 30
        }
      ]
    }
  ]
}
