{
  "titre": "OMNI - Accès mémoire LSASS (vol de credentials)",
  "critique": true,
  "mitre": "T1003.001",
  "justification": "Vol d'identifiants en mémoire ; la requête contient des exclusions (NinjaOne, WerFaultSecure) dont la régression doit être détectée dans les deux sens.",
  "capture": "2026-11-22, GET /api/events/definitions (production)",
  "definition": {
    "query": "alert_tag:lsass_access AND NOT winlogbeat_winlog_event_data_SourceImage:(*njbinarymetering* OR *NinjaOne* OR *WerFaultSecure*)",
    "streams": [
      "OMNI - Sysmon"
    ],
    "group_by": [
      "host"
    ],
    "series": [
      {
        "type": "count",
        "id": "count()",
        "field": null
      }
    ],
    "conditions": {
      "expression": {
        "expr": ">=",
        "left": {
          "expr": "number-ref",
          "ref": "count()"
        },
        "right": {
          "expr": "number",
          "value": 1.0
        }
      }
    },
    "search_within_ms": 600000,
    "execute_every_ms": 600000
  },
  "cas": [
    {
      "nom": "accès LSASS par un outil inconnu",
      "attendu": {
        "evenements": 1,
        "cles": [
          [
            "BX-PC-01"
          ]
        ]
      },
      "documents": [
        {
          "flux": "OMNI - Sysmon",
          "age_s": 60,
          "champs": {
            "alert_tag": "lsass_access",
            "host": "BX-PC-01",
            "winlogbeat_winlog_event_data_SourceImage": "C:\\Users\\Public\\procdump64.exe"
          }
        }
      ]
    },
    {
      "nom": "accès légitime de l'agent NinjaOne (exclusion)",
      "attendu": {
        "evenements": 0
      },
      "documents": [
        {
          "flux": "OMNI - Sysmon",
          "age_s": 60,
          "champs": {
            "alert_tag": "lsass_access",
            "host": "BX-PC-01",
            "winlogbeat_winlog_event_data_SourceImage": "C:\\Program Files (x86)\\NinjaOne\\njbinarymetering.exe"
          }
        }
      ]
    },
    {
      "nom": "WerFaultSecure (exclusion)",
      "attendu": {
        "evenements": 0
      },
      "documents": [
        {
          "flux": "OMNI - Sysmon",
          "age_s": 60,
          "champs": {
            "alert_tag": "lsass_access",
            "host": "BX-PC-01",
            "winlogbeat_winlog_event_data_SourceImage": "C:\\Windows\\System32\\WerFaultSecure.exe"
          }
        }
      ]
    },
    {
      "nom": "champ de regroupement host absent : pas de seau",
      "attendu": {
        "evenements": 0
      },
      "documents": [
        {
          "flux": "OMNI - Sysmon",
          "age_s": 60,
          "champs": {
            "alert_tag": "lsass_access",
            "winlogbeat_winlog_event_data_SourceImage": "C:\\x\\mimikatz.exe"
          }
        }
      ]
    }
  ]
}
