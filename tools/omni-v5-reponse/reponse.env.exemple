# /etc/omni-v5-reponse/reponse.env - AUCUN SECRET dans ce fichier (mode 644)
# Chantier 5 SIEM v5 - 27/11/2026
# Seule valeur acceptée : simulation (le service refuse de démarrer sinon ; mode réel non implémenté)
REPONSE_MODE=simulation
REPONSE_PORT=8091
# Hôtes acceptés dans Origin/Referer des formulaires
REPONSE_HOTES=bx-it-graylog-vm.omnitech.security,10.33.220.10
REPONSE_BASE_URL=https://bx-it-graylog-vm.omnitech.security
# Réseaux sources acceptés (X-Real-IP posé par nginx)
REPONSE_RESEAUX=10.0.0.0/8,127.0.0.1/32
# Domaines UPN gérés pour la révocation Entra (invités et partenaires refusés)
REPONSE_DOMAINES_UPN=omnitech-security.fr,omnitech.security
# 1 = le valideur doit être un autre compte que le demandeur (décision attendue)
REPONSE_SEPARATION=1
REPONSE_DEMANDES_MAX_5MIN=10
# Cibles protégées propres au site (obligatoire ; modèle : cibles-protegees.exemple)
REPONSE_CIBLES=/etc/omni-v5-reponse/cibles-protegees
