{
  "schema_version": 1,
  "id": "watchguard",
  "name": "WatchGuard Firebox",
  "revision": 2,
  "status": "preview",
  "default_port": 1521,
  "supported_format": "Fireware traffic messages: syslog firewall msg_id form or Traffic Monitor form; IPv4 TCP/UDP only",
  "vendor_documentation": "https://www.watchguard.com/help/docs/help-center/en-US/Content/en-US/Fireware/logging/read_log-msg.html",
  "parser": {
    "type": "regex",
    "patterns": [
      {
        "expression": "msg_id=\"([^\"]+)\"\\s+(Allow|Deny|Drop)\\s+(\\S+)\\s+(\\S+)\\s+(?:[0-9]+\\s+)?(tcp|udp)\\s+(?:[0-9]+\\s+[0-9]+\\s+)?([0-9.]+)\\s+([0-9.]+)\\s+([0-9]+)\\s+([0-9]+)",
        "fields": [
          "event_id",
          "action",
          "src_zone",
          "dest_zone",
          "protocol",
          "src_ip",
          "dest_ip",
          "src_port",
          "dest_port"
        ]
      },
      {
        "expression": "\\b(Allow|Deny|Drop)\\s+([0-9.]+)\\s+([0-9.]+)\\s+[^\\s/]+/(tcp|udp)\\s+([0-9]+)\\s+([0-9]+).*?msg_id=\"([^\"]+)\"",
        "fields": [
          "action",
          "src_ip",
          "dest_ip",
          "protocol",
          "src_port",
          "dest_port",
          "event_id"
        ]
      }
    ],
    "mapping": {
      "event_id": "event_id",
      "action": "event_action",
      "src_ip": "src_ip",
      "dest_ip": "dest_ip",
      "src_port": "src_port",
      "dest_port": "dest_port",
      "protocol": "network_protocol",
      "src_zone": "src_zone",
      "dest_zone": "dest_zone"
    }
  },
  "soc": {
    "revision": 1,
    "fields": [
      {
        "name": "source",
        "type": "keyword",
        "required": true,
        "description": "source"
      },
      {
        "name": "omni_parse_status",
        "type": "keyword",
        "required": true,
        "description": "omni parse status"
      },
      {
        "name": "event_id",
        "type": "keyword",
        "required": false,
        "description": "event id"
      },
      {
        "name": "event_action",
        "type": "keyword",
        "required": true,
        "description": "event action"
      },
      {
        "name": "src_ip",
        "type": "ip",
        "required": false,
        "description": "src ip"
      },
      {
        "name": "dest_ip",
        "type": "ip",
        "required": false,
        "description": "dest ip"
      },
      {
        "name": "src_port",
        "type": "long",
        "required": false,
        "description": "src port"
      },
      {
        "name": "dest_port",
        "type": "long",
        "required": false,
        "description": "dest port"
      },
      {
        "name": "network_protocol",
        "type": "keyword",
        "required": false,
        "description": "network protocol"
      },
      {
        "name": "src_zone",
        "type": "keyword",
        "required": false,
        "description": "src zone"
      },
      {
        "name": "dest_zone",
        "type": "keyword",
        "required": false,
        "description": "dest zone"
      }
    ],
    "preset": {
      "description": "Trafic et qualité de collecte. Consulter les limites de formats du module avant de conclure sur sa couverture.",
      "widgets": [
        {
          "id": "volume",
          "title": "Événements reçus",
          "type": "count"
        },
        {
          "id": "activite",
          "title": "Activité de collecte",
          "type": "timeseries"
        },
        {
          "id": "autorises",
          "title": "Trafic autorisé",
          "type": "count",
          "filter": [
            {
              "field": "event_action",
              "values": [
                "allow"
              ]
            }
          ]
        },
        {
          "id": "refuses",
          "title": "Trafic refusé ou abandonné",
          "type": "count",
          "filter": [
            {
              "field": "event_action",
              "values": [
                "deny",
                "drop"
              ]
            }
          ]
        },
        {
          "id": "non-parses",
          "title": "Formats non reconnus",
          "type": "count",
          "filter": [
            {
              "field": "omni_parse_status",
              "values": [
                "unparsed"
              ]
            }
          ]
        },
        {
          "id": "actions",
          "title": "Actions observées",
          "type": "terms",
          "field": "event_action"
        },
        {
          "id": "equipements",
          "title": "Équipements émetteurs",
          "type": "terms",
          "field": "source"
        },
        {
          "id": "ips-sources",
          "title": "IP sources",
          "type": "terms",
          "field": "src_ip"
        },
        {
          "id": "zones",
          "title": "Zones sources observées",
          "type": "terms",
          "field": "src_zone"
        },
        {
          "id": "journaux",
          "title": "Journaux et contexte réseau",
          "type": "messages",
          "columns": [
            "timestamp",
            "source",
            "event_action",
            "src_ip",
            "src_port",
            "dest_ip",
            "dest_port",
            "network_protocol",
            "omni_parse_status",
            "message"
          ],
          "size": 10
        }
      ]
    },
    "limitations": [
      "Les formats non reconnus restent dans les messages bruts : ils ne sont pas assimilés à du trafic normal.",
      "Aucune détection ni corrélation n’est activée par ce modèle de page.",
      "Le timestamp représente la réception, sans remplacement par le temps constructeur."
    ]
  }
}
