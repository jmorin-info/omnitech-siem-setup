[Unit]
Description=OMNI - Backend PWA mobile SIEM
After=network-online.target graylog-server.service opensearch.service
[Service]
EnvironmentFile=/etc/default/omni-mobile
ExecStart=/opt/omni-siem/repository/mobile/.venv/bin/python /opt/omni-siem/repository/mobile/omni-mobile-api.py
Restart=on-failure
User=root
[Install]
WantedBy=multi-user.target
