# ==============================================================================
# Stack SIEM Graylog - Modele de variables globales (00-vars.env.example)
#
# Copier ce fichier en 00-vars.env, remplacer chaque CHANGEME et chaque valeur
# d'exemple par les valeurs du site, puis :
#   chmod 600 00-vars.env
#
# 00-vars.env contient des secrets : il est exclu du depot par .gitignore et
# ne doit JAMAIS etre versionne.
# ==============================================================================

## ---- Identite machine -------------------------------------------------------
SIEM_HOSTNAME="siem-01"
SIEM_DOMAIN="example.interne"
SIEM_FQDN="${SIEM_HOSTNAME}.${SIEM_DOMAIN}"

## ---- Reseau ------------------------------------------------------------------
SIEM_IP="10.0.0.10"
SIEM_PREFIX="24"
SIEM_GW="10.0.0.254"             # passerelle du VLAN du SIEM (souvent le pare-feu)
SIEM_IFACE="eth0"                # interface reseau (detectee par le preflight)
APPLY_NETWORK="0"                # 1 = le script 01 ecrit la conf reseau statique
                                 # 0 = il affiche seulement le bloc a copier
DNS1="10.0.0.53"                 # serveur DNS primaire (ex : controleur de domaine)
DNS2="10.0.0.54"                 # serveur DNS secondaire
NTP1="10.0.0.53"                 # source de temps de reference (ex : PDC emulator)
NTP2="10.0.0.54"

## ---- Sous-reseaux autorises (pare-feu local nftables) -----------------------
NET_ADMIN="10.0.0.0/16"          # SSH + console web. A restreindre au VLAN d'admin
NET_BEATS="10.0.0.0/16"          # VLANs postes/serveurs emettant Winlogbeat (TCP 5044)
IP_FAZ="10.0.0.100"              # FortiAnalyzer (log forwarding syslog/CEF)
VSPHERE_NET="10.0.0.0/16"        # a restreindre au VLAN management ESXi/vCenter (syslog TCP 1516)
IP_CENTREON="10.0.0.101"         # IP du poller Centreon (vide = pas de regle SNMP)

## ---- Secrets (a generer localement, ne jamais versionner) -------------------
GRAYLOG_ADMIN_PASS='CHANGEME'
MONGO_ADMIN_PASS='CHANGEME'
MONGO_GRAYLOG_PASS='CHANGEME'
# Exige par le paquet opensearch >= 2.12 a l'installation ; devient inutile ensuite
# car on desactive le plugin de securite (OpenSearch ecoute uniquement en localhost).
OPENSEARCH_BOOTSTRAP_PASS='CHANGEME'

## ---- Teams (canal SOC) -------------------------------------------------------
# URL du webhook entrant Teams (Workflows / Power Automate) :
#   Teams > canal dedie > ... > Workflows > "Publier dans un canal lorsqu'une
#   demande de webhook est recue" > copier l'URL.
# Laisser vide = pas de notification Teams. Puis relancer 13-graylog-alerts.sh.
TEAMS_WEBHOOK_URL=''

## ---- SMTP interne (notifications d'alertes Graylog) -------------------------
SMTP_RELAY="smtp.example.interne"
SMTP_PORT="25"
SMTP_FROM="no-reply@example.fr"
ALERT_EMAIL="soc@example.fr"     # destinataire des notifications d'alertes (script 10)

## ---- SNMPv3 pour Centreon (script 09, optionnel) ----------------------------
SNMP_V3_USER="centreon"
SNMP_V3_AUTH_PASS=''             # SHA  - a definir si 09-snmpd.sh utilise
SNMP_V3_PRIV_PASS=''             # AES  - a definir si 09-snmpd.sh utilise

## ---- Dimensionnement (exemple : VM 8 vCPU / 32 Go RAM) ----------------------
OS_HEAP="12g"                    # heap OpenSearch (~1/3 RAM VM, jamais > 31g)
GL_HEAP="4g"                     # heap Graylog
MONGO_CACHE_GB="1"               # cache WiredTiger. Sans ca Mongo prend ~50% de la RAM !
JOURNAL_SIZE="10gb"              # journal disque Graylog = tampon si OpenSearch est down

## ---- Stockage ----------------------------------------------------------------
DATA_DISK="/dev/sdX"             # disque donnees, formate XFS et monte sur DATA_MOUNT
                                 # (ATTENTION : donnees detruites au formatage !)
DATA_MOUNT="/data"               # OpenSearch -> /data/opensearch ; journal Graylog -> /data/graylog-journal
BACKUP_DIR="/home/siem-backup"   # de preference sur un disque physique distinct des donnees
RETENTION_DAYS="14"              # retention locale des sauvegardes

## ---- Microsoft 365 / Entra ID (app collector, cf. M365.md) ------------------
M365_TENANT_ID='CHANGEME'
M365_CLIENT_ID='CHANGEME'
M365_CLIENT_SECRET='CHANGEME'

# Passphrase de chiffrement des sauvegardes config (A COPIER DANS LE
# COFFRE-FORT : sans elle, les archives sont irrecuperables)
BACKUP_PASSPHRASE=CHANGEME

# --- LDAPS console Graylog (33-ldaps-auth.sh) --------------------------------
LDAP_HOST='dc01.example.interne'
LDAP_BIND_DN='svc_siem@example.interne'
LDAP_BIND_PASS='CHANGEME'
LDAP_REQUIRED_GROUP_DN='CN=Groupe-SIEM,OU=Groupes,DC=example,DC=interne'

# --- Rapport hebdomadaire (34-weekly-report.sh / omni-weekly-report) ---------
REPORT_RECIPIENTS='soc@example.fr'
REPORT_FROM='no-reply@example.fr'
REPORT_SMTP='smtp.example.interne'
REPORT_SMTP_PORT='25'

# --- SOAR-light : blocage auto d'IP attaquantes (36-soar.sh / omni-soar) -----
SOAR_TTL_HOURS='24'              # duree de blocage d'une IP (heures)
SOAR_MAX='500'                   # taille max de la liste de blocage
SOAR_WHITELIST='198.51.100.1,203.0.113.1'   # IP publiques a ne JAMAIS bloquer (sites, partenaires)
SOAR_MIN_HITS='5'                # nb minimal de hits avant blocage

# --- Supervision collecte : couverture SLA + go-dark (39 / omni-collect-health)
# COLLECT_GO_DARK_HOURS : hote gere muet > N h = go-dark (tolere une nuit + marge)
# COLLECT_MANAGED_DAYS  : hote muet > N j = decommissionne (sorti du calcul SLA)
COLLECT_GO_DARK_HOURS='26'
COLLECT_MANAGED_DAYS='14'

# --- Carte cyber temps reel (42-carte-cyber.sh / omni-geo-flux) --------------
# GEO_HQ_LAT/LON/NAME : point de destination des arcs (siege / datacenter)
# GEO_FLUX_WINDOW_MIN : fenetre glissante d'agregation ; GEO_FLUX_MAX : nb d'arcs
GEO_HQ_LAT='48.85'
GEO_HQ_LON='2.35'
GEO_HQ_NAME='Siege (Paris)'
GEO_FLUX_WINDOW_MIN='10'
GEO_FLUX_MAX='160'

# --- Detection de scan reseau (48-ndr-scan.sh / omni-ndr-scan) ---------------
# SCAN_WINDOW_M : fenetre (min) ; SCAN_HOST_MIN : dest_ip distincts -> horizontal
# SCAN_PORT_MIN : dest_port distincts -> vertical
SCAN_WINDOW_M='60'
SCAN_HOST_MIN='30'
SCAN_PORT_MIN='25'
# SCAN_ALLOW_SRC : IP d'infra de SUPERVISION legitimes (NMS/sondes balayant le
# parc par nature = faux scan). CSV. Ne PAS y mettre de controleur de domaine
# ni de serveur applicatif : un DC qui scanne reste un signal a garder.
SCAN_ALLOW_SRC='10.0.0.102'

# --- omni-ndr-beacon : whitelist d'appareils benins (trafic regulier PAR NATURE)
# IP SOURCE a exclure de la detection de beaconing (qualifiees faux positifs) :
# telephonie VoIP (SIP/STUN), systemes video en polling, etc. CSV.
NDR_BEACON_WHITELIST_SRC='10.0.0.103,10.0.0.104'

# --- omni-ndr-exfil : exfiltration par VOLUME (FortiGate bytes_sent) ---------
# EXFIL_WINDOW_M (min), EXFIL_BYTES_GB (seuil Go), EXFIL_TOP (couples examines),
# EXFIL_ALLOW_DEST (IP egress legitimes, ex egress HTTPS du SIEM), EXFIL_ALLOW_SRC.
EXFIL_WINDOW_M='60'
EXFIL_BYTES_GB='1'
EXFIL_TOP='50'
EXFIL_ALLOW_DEST='203.0.113.10'
EXFIL_ALLOW_SRC=''

# --- Nouvelles sources de logs (52-new-sources.sh) ---------------------------
IP_ESET='10.0.0.20'              # ESET PROTECT -> syslog TCP (514 redirige vers 1515)
IP_NPS='10.0.0.21'               # Windows NPS (RADIUS) -> Winlogbeat (Security 6272-6274)
IP_BUNKERWEB='10.0.0.22'         # BunkerWeb (WAF) -> Filebeat vers Beats 5044
ESET_PORT='1515'                 # port d'ecoute reel cote SIEM (514 redirige -> 1515)
IP_EMS='10.0.0.23'               # FortiClient EMS -> syslog-over-TLS TCP (514 redirige vers 1518)
EMS_PORT='1518'                  # port d'ecoute reel cote SIEM (514 redirige -> 1518, input TLS)
IP_CERT='10.0.0.24'              # orchestrateur de certificats -> GELF UDP 12201

# --- FortiGate DHCP (collecteur omni-fortidhcp-fetch) ------------------------
# Cle API FortiGate en LECTURE SEULE (compte de service dedie)
FORTI_DHCP_HOST='10.0.0.254'
FORTI_DHCP_TOKEN='CHANGEME'
FORTI_DHCP_PORT='4443'
# Comptes de service legitimes a exclure de la detection de reconnaissance LDAP (CSV)
LDAPRECON_ALLOW=svc_exemple1,svc_exemple2,SRV-EXEMPLE$
