# =============================================================================
# Configuration du poller SLA SEAL (/etc/oms-seal-sla/seal-sla.env, mode 0644).
# AUCUN SECRET : le poller lit OpenSearch en local (127.0.0.1:9200) et emet en
# GELF local ; il ne detient aucun identifiant. Copier ce modele et ajuster.
# =============================================================================

# --- Lecture (OpenSearch local du SIEM) --------------------------------------
OPENSEARCH_URL=http://127.0.0.1:9200
SEAL_ALARM_INDEX=omni-seal-alarm_*
# ID du stream "OMNI - SEAL Alarmes" (filtre de securite ; vide = tous index ci-dessus)
SEAL_ALARM_STREAM=6a50faca3411482ad6e00e57

# --- Emission des marqueurs (input GELF HTTP du SIEM) ------------------------
GELF_HOST=127.0.0.1
GELF_PORT=12201
GELF_PROTO=http

# --- Politique SLA -----------------------------------------------------------
# Fenetre d'examen : une alarme plus vieille est supposee triee/archivee.
SEAL_SLA_LOOKBACK_HOURS=48
# Etat local (idempotence + escalade). Repertoire cree par l'installateur.
SEAL_SLA_STATE_FILE=/var/lib/oms-seal-sla/state.json
# Escalade : re-emet un marqueur quand l'age depasse (facteur x SLA) cumulativement.
# 0 = jamais de re-emission (un seul marqueur par breche).
SEAL_SLA_ESCALATION_FACTOR=4

# --- Set de codes severes (facultatif) ---------------------------------------
# Par defaut, set integre (SEM218 intrusion video, SEM113 effraction, SEM805
# declencheur manuel = critiques 15 min ; SEM118 bouton bloque, SEM73 base UTL
# modifiee = eleves 60 min). Pour AJUSTER : pointer un JSON {code:{cls,sla,label}}.
#   cls  = critical | high (route SLA-001 vs SLA-002 + severite notif)
#   sla  = delai en minutes avant breche
# SEAL_SLA_CODES_FILE=/etc/oms-seal-sla/severe-codes.json
# SEAL_SLA_CODES_MODE=merge          # merge (defaut, complete le set) | replace (set 100% custom)

# --- SLA differencie par site (facultatif) -----------------------------------
# Multiplicateur applique au delai selon le site (ex. prod plus stricte = <1).
# SEAL_SLA_SITE_MULT={"bx-seal-omega":1.0,"bx-qa-seal-vm":1.5}

# --- Tests uniquement --------------------------------------------------------
# 1 = inclut les evenements taggues TEST_SIEM et tague les marqueurs emis
# (exclus des detections). Laisser 0 en production.
# SEAL_SLA_INCLUDE_TEST=0
